@page "/sns"
@page "/sns/{TopicArn?}"
@using AwsLocalStackVisualizer.Abstractions
@using AwsLocalStackVisualizer.Models.SNS
@using AwsLocalStackVisualizer.Services
@using AwsLocalStackVisualizer.Configuration
@inject ILocalStackService LocalStackService
@inject IReadOnlyService ReadOnlyService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject AwsRegionContext RegionContext
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>SNS Viewer - LocalStack Visualizer</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5">
                        SNS Tópicos
                    </h1>
                    @if (!string.IsNullOrEmpty(TopicArn))
                    {
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/sns" class="text-decoration-none">Tópicos</a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">@GetTopicName(TopicArn)</li>
                            </ol>
                        </nav>
                    }
                </div>
                <div class="btn-group">
                    @if (string.IsNullOrEmpty(TopicArn))
                    {
                        <button class="btn btn-success" @onclick="ShowCreateTopicModal" disabled="@ReadOnlyService.IsReadOnly">
                            <i class="bi bi-plus-circle"></i> Criar Tópico
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="() => ShowPublishMessageModal()" disabled="@ReadOnlyService.IsReadOnly">
                            <i class="bi bi-megaphone"></i> Publicar Mensagem
                        </button>
                    }
                    <button class="btn btn-outline-primary" @onclick="RefreshData">
                        <i class="bi bi-arrow-clockwise"></i> Atualizar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="row">
            <div class="col-12 text-center">
                <div class="spinner-border text-warning" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
                <p class="mt-2">Carregando dados do SNS...</p>
            </div>
        </div>
    }
    else if (hasError)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Erro ao carregar dados</h4>
                    <p>Não foi possível conectar ao serviço SNS do LocalStack.</p>
                    <button class="btn btn-outline-danger" @onclick="RefreshData">
                        <i class="bi bi-arrow-clockwise"></i> Tentar Novamente
                    </button>
                </div>
            </div>
        </div>
    }
    else if (string.IsNullOrEmpty(TopicArn))
    {
        <div class="row">
            <div class="col-12">
                <h3>Tópicos Disponíveis</h3>
                @if (topics.Any())
                {
                    <div class="row">
                        @foreach (var topic in paginatedTopics)
                        {
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <i class="bi bi-broadcast text-warning"></i>
                                            @topic.Name
                                        </h5>
                                        <div class="row text-center mb-3">
                                            <div class="col-6">
                                                <h6 class="text-primary mb-0">@topic.SubscriptionsCount</h6>
                                                <small class="text-muted">Assinaturas</small>
                                            </div>
                                            <div class="col-6">
                                                <h6 class="text-info mb-0">@GetTopicMessageCount(topic.Arn)</h6>
                                                <small class="text-muted">Mensagens</small>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="mb-2">
                                            <small class="text-muted">
                                                <strong>ARN:</strong>
                                            </small>
                                            <br>
                                            <code class="small">@topic.Arn</code>
                                        </div>
                                        <small class="text-muted">
                                            Criado em: @topic.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                    <div class="card-footer">
                                        <div class="d-grid gap-2">
                                            <button class="btn btn-warning btn-sm"
                                                    @onclick="() => NavigateToTopic(topic.Arn)">
                                                <i class="bi bi-eye"></i> Visualizar Assinaturas
                                            </button>
                                            <div class="btn-group">
                                                <button class="btn btn-outline-success btn-sm"
                                                        @onclick="() => ShowPublishMessageModal(topic.Arn, topic.Name)">
                                                    <i class="bi bi-megaphone"></i> Publicar
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm"
                                                        @onclick="() => ShowDeleteTopicModal(topic.Arn, topic.Name)"
                                                        disabled="@ReadOnlyService.IsReadOnly">
                                                    <i class="bi bi-trash"></i> Excluir
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="row mt-4">
                            <div class="col-12">
                                <nav aria-label="Paginação de tópicos">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)">
                                                <i class="bi bi-chevron-left"></i> Anterior
                                            </button>
                                        </li>

                                        @for (int page = 1; page <= totalPages; page++)
                                        {
                                            var pageNumber = page;
                                            <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                                <button class="page-link" @onclick="() => GoToPage(pageNumber)">
                                                    @pageNumber
                                                </button>
                                            </li>
                                        }

                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == totalPages)">
                                                Próxima <i class="bi bi-chevron-right"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                                <div class="text-center text-muted">
                                    <small>Página @currentPage de @totalPages (@topics.Count tópicos no total)</small>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <h4 class="alert-heading">Nenhum tópico encontrado</h4>
                        <p>Não há tópicos SNS criados no LocalStack.</p>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        @if (topicDetails != null)
        {
            var subCount = topicDetails.Subscriptions.Count;
            var msgCount = topicDetails.Messages.Count;
            var regionLabel = GetRegionFromTopicArn(topicDetails.TopicInfo.Arn);

            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                                <div>
                                    <div class="text-uppercase text-muted small fw-semibold mb-1">Tópico</div>
                                    <h2 class="h4 mb-0 d-flex align-items-center gap-2">
                                        <span class="rounded-circle bg-warning bg-opacity-25 p-2 d-inline-flex align-items-center justify-content-center">
                                            <i class="bi bi-broadcast text-warning"></i>
                                        </span>
                                        @topicDetails.TopicInfo.Name
                                    </h2>
                                    <div class="mt-2">
                                        @if (!string.IsNullOrEmpty(regionLabel))
                                        {
                                            <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">
                                                <i class="bi bi-geo-alt"></i> @regionLabel
                                            </span>
                                        }
                                        <span class="badge rounded-pill bg-light text-muted border ms-1">
                                            <i class="bi bi-clock"></i> @topicDetails.TopicInfo.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-outline-primary" @onclick="RefreshData">
                                        <i class="bi bi-arrow-clockwise"></i> Atualizar detalhes
                                    </button>
                                    <button class="btn btn-outline-danger" @onclick="() => ShowDeleteTopicModal(topicDetails.TopicInfo.Arn, topicDetails.TopicInfo.Name)" disabled="@ReadOnlyService.IsReadOnly">
                                        <i class="bi bi-trash"></i> Excluir
                                    </button>
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-6 col-md-3">
                                    <div class="rounded-3 border bg-primary bg-opacity-10 p-3 h-100">
                                        <div class="small text-primary text-opacity-75 fw-semibold">Assinaturas</div>
                                        <div class="fs-3 fw-bold text-primary">@subCount</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="rounded-3 border bg-info bg-opacity-10 p-3 h-100">
                                        <div class="small text-info text-opacity-75 fw-semibold">Mensagens (LocalStack)</div>
                                        <div class="fs-3 fw-bold text-info">@msgCount</div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="rounded-3 border p-3 h-100 bg-light">
                                        <div class="small text-muted fw-semibold mb-1">ARN</div>
                                        <code class="small text-break user-select-all d-block">@topicDetails.TopicInfo.Arn</code>
                                    </div>
                                </div>
                            </div>

                            <ul class="nav nav-pills nav-fill gap-2 gap-md-0 flex-column flex-md-row mb-0" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link @(topicDetailsTab == "subscriptions" ? "active" : "") py-3"
                                            @onclick='() => SetTopicDetailsTab("subscriptions")'>
                                        <i class="bi bi-link-45deg me-1"></i> Assinaturas
                                        <span class="badge bg-secondary ms-1">@subCount</span>
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link @(topicDetailsTab == "messages" ? "active" : "") py-3"
                                            @onclick='() => SetTopicDetailsTab("messages")'>
                                        <i class="bi bi-envelope-paper me-1"></i> Mensagens publicadas
                                        <span class="badge bg-secondary ms-1">@msgCount</span>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            @if (topicDetailsTab == "subscriptions")
            {
                <div class="row">
                    <div class="col-12">
                        @if (topicDetails.Subscriptions.Any())
                        {
                            <div class="table-responsive card border-0 shadow-sm">
                                <table class="table table-hover table-striped mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col" style="width:8rem">Protocolo</th>
                                            <th scope="col">Endpoint</th>
                                            <th scope="col" style="width:9rem">Status</th>
                                            <th scope="col" style="width:8rem">Conta</th>
                                            <th scope="col">ARN da assinatura</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var subscription in topicDetails.Subscriptions)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="badge @GetProtocolBadgeClass(subscription.Protocol) text-wrap">
                                                        <i class="@GetProtocolIcon(subscription.Protocol)"></i>
                                                        @subscription.Protocol.ToUpperInvariant()
                                                    </span>
                                                </td>
                                                <td><code class="small text-break d-inline-block" style="max-width:22rem">@subscription.Endpoint</code></td>
                                                <td>
                                                    @if (subscription.ConfirmationWasAuthenticated)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-check-circle"></i> Confirmada
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="bi bi-hourglass-split"></i> Pendente
                                                        </span>
                                                    }
                                                </td>
                                                <td><span class="small text-muted">@subscription.Owner</span></td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(subscription.SubscriptionArn) &&
                                                         subscription.SubscriptionArn != "PendingConfirmation")
                                                    {
                                                        <code class="small text-break d-inline-block" style="max-width:24rem">@subscription.SubscriptionArn</code>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Aguardando confirmação</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="row g-3 mt-3">
                                @{
                                    var groupedSubscriptions = topicDetails.Subscriptions
                                        .GroupBy(s => s.Protocol)
                                        .OrderByDescending(g => g.Count())
                                        .ToList();
                                    var confirmedCount = topicDetails.Subscriptions.Count(s => s.ConfirmationWasAuthenticated);
                                    var pendingCount = topicDetails.Subscriptions.Count(s => !s.ConfirmationWasAuthenticated);
                                }
                                <div class="col-6 col-md-3">
                                    <div class="card border-0 bg-success bg-opacity-10 h-100">
                                        <div class="card-body text-center py-3">
                                            <div class="fs-4 fw-bold text-success">@confirmedCount</div>
                                            <small class="text-muted">Confirmadas</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card border-0 bg-warning bg-opacity-10 h-100">
                                        <div class="card-body text-center py-3">
                                            <div class="fs-4 fw-bold text-warning text-dark">@pendingCount</div>
                                            <small class="text-muted">Pendentes</small>
                                        </div>
                                    </div>
                                </div>
                                @foreach (var g in groupedSubscriptions.Take(4))
                                {
                                    <div class="col-6 col-md-3">
                                        <div class="card border-0 bg-light h-100">
                                            <div class="card-body text-center py-3">
                                                <div class="fs-4 fw-bold text-primary">@g.Count()</div>
                                                <small class="text-muted text-uppercase">@g.Key</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center py-5">
                                    <i class="bi bi-link-45deg display-4 text-muted opacity-50"></i>
                                    <h5 class="mt-3">Nenhuma assinatura</h5>
                                    <p class="text-muted mb-0 small">Use a fila SQS ou a CLI para associar destinos a este tópico.</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-12">
                        @if (topicDetails.Messages.Any())
                        {
                            <div class="alert alert-light border small mb-4">
                                <i class="bi bi-lightbulb text-warning"></i>
                                Histórico de publicações exposto pelo LocalStack (<code class="small">/_aws/sns/messages</code>). Na AWS real o SNS não armazena fila de mensagens do tópico.
                            </div>

                            <div class="vstack gap-2">
                                @for (var i = 0; i < topicDetails.Messages.Count; i++)
                                {
                                    var message = topicDetails.Messages[i];
                                    var expanded = _expandedMessageIndex == i;
                                    var title = !string.IsNullOrEmpty(message.Subject)
                                        ? message.Subject
                                        : $"Mensagem {ShortMessageId(message.MessageId)}";
                                    <div class="card border-0 shadow-sm overflow-hidden">
                                        <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2 py-3 @(expanded ? "border-bottom" : "")"
                                             style="cursor: pointer;"
                                             @onclick="() => ToggleMessageDetail(i)">
                                            <div class="d-flex align-items-center gap-2 min-w-0">
                                                <span class="badge bg-dark">#@(i + 1)</span>
                                                <span class="fw-semibold text-truncate" title="@title">@title</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 small text-muted flex-shrink-0">
                                                <span>@message.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                                <i class="bi @(expanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                            </div>
                                        </div>
                                        @if (expanded)
                                        {
                                            <div class="card-body pt-3">
                                                <dl class="row small mb-3">
                                                    <dt class="col-sm-2 text-muted">Message ID</dt>
                                                    <dd class="col-sm-10"><code class="text-break user-select-all">@message.MessageId</code></dd>
                                                </dl>
                                                <div class="fw-semibold small text-muted mb-2">Corpo</div>
                                                <div class="rounded-3 border bg-light p-3">
                                                    <pre class="mb-0 small" style="white-space: pre-wrap; word-break: break-word; max-height: 20rem; overflow-y: auto;">@FormatMessageBody(message.Message)</pre>
                                                </div>
                                                @if (message.MessageAttributes.Any())
                                                {
                                                    <div class="fw-semibold small text-muted mt-3 mb-2">Atributos</div>
                                                    <div class="table-responsive rounded-3 border">
                                                        <table class="table table-sm table-striped mb-0">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Nome</th>
                                                                    <th>Valor</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var attr in message.MessageAttributes)
                                                                {
                                                                    <tr>
                                                                        <td class="text-nowrap"><code>@attr.Key</code></td>
                                                                        <td class="text-break">@attr.Value</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center py-5">
                                    <i class="bi bi-envelope-open display-4 text-muted opacity-50"></i>
                                    <h5 class="mt-3">Nenhuma mensagem listada</h5>
                                    <p class="text-muted small mb-3">Publique pelo botão acima ou aguarde o LocalStack expor o histórico interno.</p>
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="RefreshData">
                                        <i class="bi bi-arrow-clockwise"></i> Tentar carregar de novo
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }
</div>

@if (showCreateTopicModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Criar Novo Tópico SNS</h5>
                    <button type="button" class="btn-close" @onclick="HideCreateTopicModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="topicName" class="form-label">Nome do Tópico</label>
                        <input type="text" class="form-control" id="topicName" @bind="newTopicName" placeholder="Digite o nome do tópico">
                        <div class="form-text">O nome deve ser único e seguir as regras de nomenclatura do SNS.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateTopicModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="CreateTopic" disabled="@(isCreatingTopic || string.IsNullOrWhiteSpace(newTopicName))">
                        @if (isCreatingTopic)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Criar Tópico
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showPublishMessageModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Publicar Mensagem no Tópico</h5>
                    <button type="button" class="btn-close" @onclick="HidePublishMessageModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="publishSubject" class="form-label">Assunto (Opcional)</label>
                        <input type="text" class="form-control" id="publishSubject" @bind="publishSubject" placeholder="Assunto da mensagem">
                    </div>
                    <div class="mb-3">
                        <label for="publishMessage" class="form-label">Mensagem</label>
                        <div class="position-relative">
                            <textarea class="form-control font-monospace"
                                      id="publishMessage"
                                      rows="12"
                                      @bind="publishMessage"
                                      @oninput="OnPublishMessageInput"
                                      placeholder="Digite a mensagem a ser publicada..."
                                      style="resize: vertical; font-size: 14px; line-height: 1.4;"></textarea>
                            <div class="position-absolute top-0 end-0 p-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="FormatJsonPublishMessage" title="Formatar e organizar JSON">
                                    <i class="bi bi-braces me-1"></i>Formatar JSON
                                </button>
                            </div>
                        </div>
                        <div class="form-text d-flex justify-content-between align-items-center">
                            <span>A mensagem será enviada para todos os assinantes do tópico.</span>
                            <span class="@(isValidPublishJson ? "text-success" : (publishJsonValidationMessage != null ? "text-danger" : "text-muted"))">
                                @if (isValidPublishJson)
                                {
                                    <i class="bi bi-check-circle-fill"></i><text> JSON válido</text>
                                }
                                else if (publishJsonValidationMessage != null)
                                {
                                    <i class="bi bi-exclamation-triangle-fill"></i> @publishJsonValidationMessage
                                }
                                else
                                {
                                    <span>Caracteres: @publishMessage.Length</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HidePublishMessageModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="PublishMessage" disabled="@(isPublishingMessage || string.IsNullOrWhiteSpace(publishMessage))">
                        @if (isPublishingMessage)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Publicar Mensagem
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@if (showDeleteTopicModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Exclusão do Tópico</h5>
                    <button type="button" class="btn-close" @onclick="HideDeleteTopicModal"></button>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja excluir o tópico <strong>@topicNameToDelete</strong>?</p>
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Atenção:</strong> Esta ação não pode ser desfeita e todas as assinaturas serão removidas!
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideDeleteTopicModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteTopic" disabled="@isDeletingTopic">
                        @if (isDeletingTopic)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Excluir Tópico
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? TopicArn { get; set; }

    private List<SnsTopicInfo> topics = new();
    private SnsTopicDetails? topicDetails;
    private bool isLoading = true;
    private bool hasError = false;

    private int currentPage = 1;
    private const int itemsPerPage = 6;
    private int totalPages => (int)Math.Ceiling((double)topics.Count / itemsPerPage);
    private List<SnsTopicInfo> paginatedTopics => topics.Skip((currentPage - 1) * itemsPerPage).Take(itemsPerPage).ToList();

    private bool showCreateTopicModal = false;
    private string newTopicName = string.Empty;
    private bool isCreatingTopic = false;

    private bool showPublishMessageModal = false;
    private string publishMessage = string.Empty;
    private string publishSubject = string.Empty;
    private bool isPublishingMessage = false;
    private bool isValidPublishJson = false;
    private string? publishJsonValidationMessage = null;


    private bool showDeleteTopicModal = false;
    private string topicToDelete = string.Empty;
    private string topicNameToDelete = string.Empty;
    private bool isDeletingTopic = false;

    private string selectedTopicArn = string.Empty;
    private string selectedTopicName = string.Empty;

    private string topicDetailsTab = "subscriptions";

    private int? _expandedMessageIndex;

    protected override void OnInitialized()
    {
        RegionContext.RegionChanged += OnRegionChangedRefreshContent;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private void OnRegionChangedRefreshContent()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        RegionContext.RegionChanged -= OnRegionChangedRefreshContent;
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(TopicArn))
            {
                var result = await LocalStackService.GetSnsTopicsAsync();
                topics = result.IsSuccess && result.Data != null ? result.Data.ToList() : new List<SnsTopicInfo>();
                topicDetails = null;
                await LoadTopicMessageCounts();
            }
            else
            {
                topicDetailsTab = "subscriptions";
                var result = await LocalStackService.GetSnsTopicDetailsAsync(TopicArn);
                topicDetails = result.IsSuccess ? result.Data : null;
                topics.Clear();
                if (topicDetails?.Messages.Count > 0)
                    _expandedMessageIndex = 0;
                else
                    _expandedMessageIndex = null;
            }
        }
        catch (Exception)
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private async Task NavigateToTopic(string topicArn)
    {
        var encodedArn = System.Web.HttpUtility.UrlEncode(topicArn);
        await JSRuntime.InvokeVoidAsync("eval", $"window.location.href = '/sns/{encodedArn}'");
    }

    private string GetTopicName(string topicArn)
    {
        return topicArn.Split(':').LastOrDefault() ?? topicArn;
    }

    private static string GetRegionFromTopicArn(string? arn)
    {
        if (string.IsNullOrEmpty(arn))
            return string.Empty;
        var parts = arn.Split(':', StringSplitOptions.None);
        return parts.Length >= 4 ? parts[3] : string.Empty;
    }

    private static string ShortMessageId(string? messageId)
    {
        if (string.IsNullOrEmpty(messageId))
            return "—";
        return messageId.Length <= 12 ? messageId : messageId[..8] + "…";
    }

    private void SetTopicDetailsTab(string tab)
    {
        topicDetailsTab = tab;
        StateHasChanged();
    }

    private void ToggleMessageDetail(int index)
    {
        _expandedMessageIndex = _expandedMessageIndex == index ? null : index;
        StateHasChanged();
    }

    private string GetProtocolBadgeClass(string protocol)
    {
        return protocol.ToLower() switch
        {
            "email" => "bg-primary",
            "email-json" => "bg-info",
            "sms" => "bg-success",
            "sqs" => "bg-warning",
            "http" => "bg-secondary",
            "https" => "bg-dark",
            "lambda" => "bg-danger",
            _ => "bg-light text-dark"
        };
    }

    private string GetProtocolIcon(string protocol)
    {
        return protocol.ToLower() switch
        {
            "email" or "email-json" => "bi bi-envelope",
            "sms" => "bi bi-phone",
            "sqs" => "bi bi-list-ul",
            "http" or "https" => "bi bi-globe",
            "lambda" => "bi bi-lightning",
            _ => "bi bi-question-circle"
        };
    }

    private void ShowCreateTopicModal()
    {
        newTopicName = string.Empty;
        showCreateTopicModal = true;
    }

    private void HideCreateTopicModal()
    {
        showCreateTopicModal = false;
        newTopicName = string.Empty;
    }

    private async Task CreateTopic()
    {
        if (string.IsNullOrWhiteSpace(newTopicName))
            return;

        isCreatingTopic = true;
        StateHasChanged();

        try
        {
            var result = await LocalStackService.CreateSnsTopicAsync(newTopicName);
            if (result.IsSuccess)
            {
                HideCreateTopicModal();
                await LoadData();
            }
        }
        finally
        {
            isCreatingTopic = false;
            StateHasChanged();
        }
    }

    private void ShowPublishMessageModal(string topicArn = "", string topicName = "")
    {
        publishMessage = string.Empty;
        publishSubject = string.Empty;
        showPublishMessageModal = true;

        if (!string.IsNullOrEmpty(topicArn) && !string.IsNullOrEmpty(topicName))
        {
            selectedTopicArn = topicArn;
            selectedTopicName = topicName;
        }
    }

    private void HidePublishMessageModal()
    {
        showPublishMessageModal = false;
        publishMessage = string.Empty;
        publishSubject = string.Empty;
        isValidPublishJson = false;
        publishJsonValidationMessage = null;
    }

    private async Task PublishMessage()
    {
        if (string.IsNullOrWhiteSpace(publishMessage))
            return;

        string topicArn = "";
        if (!string.IsNullOrEmpty(TopicArn))
        {
            topicArn = TopicArn;
        }
        else if (!string.IsNullOrEmpty(selectedTopicArn))
        {
            topicArn = selectedTopicArn;
        }

        if (string.IsNullOrEmpty(topicArn))
            return;

        isPublishingMessage = true;
        StateHasChanged();

        try
        {
            var finalSubject = string.IsNullOrWhiteSpace(publishSubject)
                ? $"Mensagem SNS - {DateTime.Now:dd/MM/yyyy HH:mm:ss}"
                : publishSubject;

            var result = await LocalStackService.PublishSnsMessageAsync(topicArn, publishMessage, finalSubject);
            if (result.IsSuccess)
            {
                HidePublishMessageModal();
                await LoadData();
            }
        }
        finally
        {
            isPublishingMessage = false;
            StateHasChanged();
        }
    }

    private void OnPublishMessageInput(ChangeEventArgs e)
    {
        publishMessage = e.Value?.ToString() ?? string.Empty;
        ValidatePublishJsonSilently();
    }

    private void ValidatePublishJsonSilently()
    {
        if (string.IsNullOrWhiteSpace(publishMessage))
        {
            isValidPublishJson = false;
            publishJsonValidationMessage = null;
            return;
        }

        var trimmed = publishMessage.Trim();
        if (!trimmed.StartsWith("{") && !trimmed.StartsWith("["))
        {
            isValidPublishJson = false;
            publishJsonValidationMessage = null;
            return;
        }

        try
        {
            System.Text.Json.JsonDocument.Parse(publishMessage);
            isValidPublishJson = true;
            publishJsonValidationMessage = null;
        }
        catch (System.Text.Json.JsonException ex)
        {
            isValidPublishJson = false;
            publishJsonValidationMessage = $"JSON inválido: {ex.Message}";
        }
    }

    private void FormatJsonPublishMessage()
    {
        if (string.IsNullOrWhiteSpace(publishMessage))
            return;

        try
        {
            var jsonDoc = System.Text.Json.JsonDocument.Parse(publishMessage);
            publishMessage = System.Text.Json.JsonSerializer.Serialize(jsonDoc, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
            ValidatePublishJsonSilently();
            StateHasChanged();
        }
        catch (System.Text.Json.JsonException ex)
        {
            publishJsonValidationMessage = $"Erro ao formatar: {ex.Message}";
            isValidPublishJson = false;
            StateHasChanged();
        }
    }



    private void ShowDeleteTopicModal(string topicArn, string topicName)
    {
        topicToDelete = topicArn;
        topicNameToDelete = topicName;
        showDeleteTopicModal = true;
    }

    private void HideDeleteTopicModal()
    {
        showDeleteTopicModal = false;
        topicToDelete = string.Empty;
        topicNameToDelete = string.Empty;
    }

    private async Task DeleteTopic()
    {
        if (string.IsNullOrEmpty(topicToDelete))
            return;

        isDeletingTopic = true;
        StateHasChanged();

        try
        {
            var result = await LocalStackService.DeleteSnsTopicAsync(topicToDelete);
            if (result.IsSuccess)
            {
                HideDeleteTopicModal();
                if (!string.IsNullOrEmpty(TopicArn) && TopicArn == topicToDelete)
                {
                    Navigation.NavigateTo("/sns", forceLoad: true);
                }
                else
                {
                    await LoadData();
                }
            }
        }
        finally
        {
            isDeletingTopic = false;
            StateHasChanged();
        }
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private string FormatMessageBody(string body)
    {
        try
        {
            if (body.TrimStart().StartsWith("{") || body.TrimStart().StartsWith("["))
            {
                var jsonDoc = System.Text.Json.JsonDocument.Parse(body);
                return System.Text.Json.JsonSerializer.Serialize(jsonDoc, new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = true
                });
            }
        }
        catch
        {
        }

        return body;
    }

    private Dictionary<string, int> topicMessageCounts = new();

    private int GetTopicMessageCount(string topicArn)
    {
        if (topicMessageCounts.TryGetValue(topicArn, out var count))
            return count;
        return 0;
    }

    private async Task LoadTopicMessageCounts()
    {
        foreach (var topic in topics)
        {
            try
            {
                var result = await LocalStackService.GetSnsTopicMessagesAsync(topic.Arn);
                if (result.IsSuccess && result.Data != null)
                {
                    topicMessageCounts[topic.Arn] = result.Data.Count;
                }
            }
            catch
            {
                topicMessageCounts[topic.Arn] = 0;
            }
        }
        StateHasChanged();
    }
}


