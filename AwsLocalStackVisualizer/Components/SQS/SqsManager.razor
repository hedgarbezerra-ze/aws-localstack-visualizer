@page "/sqs"
@page "/sqs/{QueueName?}"
@using AwsLocalStackVisualizer.Abstractions
@using AwsLocalStackVisualizer.Models.SQS
@using AwsLocalStackVisualizer.Models.SNS
@using AwsLocalStackVisualizer.Services
@inject ILocalStackService LocalStackService
@inject IReadOnlyService ReadOnlyService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>SQS Manager - LocalStack Visualizer</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5">
                        SQS Filas
                    </h1>
                    @if (!string.IsNullOrEmpty(QueueName))
                    {
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/sqs" class="text-decoration-none">Filas</a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">@QueueName</li>
                            </ol>
                        </nav>
                    }
                </div>
                <div class="btn-group">
                    @if (string.IsNullOrEmpty(QueueName))
                    {
                        <button class="btn btn-success" @onclick="ShowCreateQueueModal" disabled="@ReadOnlyService.IsReadOnly">
                            <i class="bi bi-plus-circle"></i> Criar Fila
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="() => ShowSendMessageModal()" disabled="@ReadOnlyService.IsReadOnly">
                            <i class="bi bi-send"></i> Enviar Mensagem
                        </button>
                        <button class="btn btn-info" @onclick="() => ShowSubscribeToSnsModal()" disabled="@ReadOnlyService.IsReadOnly">
                            <i class="bi bi-link"></i> Associar ao SNS
                        </button>
                    }
                    <button class="btn btn-outline-primary" @onclick="RefreshData">
                        <i class="bi bi-arrow-clockwise"></i> Atualizar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="row">
            <div class="col-12 text-center">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
                <p class="mt-2">Carregando dados do SQS...</p>
            </div>
        </div>
    }
    else if (hasError)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Erro ao carregar dados</h4>
                    <p>Não foi possível conectar ao serviço SQS do LocalStack.</p>
                    <button class="btn btn-outline-danger" @onclick="RefreshData">
                        <i class="bi bi-arrow-clockwise"></i> Tentar Novamente
                    </button>
                </div>
            </div>
        </div>
    }
    else if (string.IsNullOrEmpty(QueueName))
    {
        <div class="row">
            <div class="col-12">
                <h3>Filas Disponíveis</h3>
                @if (queues.Any())
                {
                    <div class="row">
                        @foreach (var queue in paginatedQueues)
                        {
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <i class="bi bi-inbox text-success"></i>
                                            @queue.Name
                                        </h5>
                                        <div class="row text-center mb-3">
                                            <div class="col-6">
                                                <h6 class="text-primary mb-0">@queue.ApproximateNumberOfMessages</h6>
                                                <small class="text-muted">Mensagens</small>
                                            </div>
                                            <div class="col-6">
                                                <h6 class="text-warning mb-0">@queue.ApproximateNumberOfMessagesNotVisible</h6>
                                                <small class="text-muted">Em Processamento</small>
                                            </div>
                                        </div>
                                        <hr>
                                        <small class="text-muted">
                                            Criada em: @queue.CreatedTimestamp.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                    <div class="card-footer">
                                        <div class="d-grid gap-2">
                                            <button class="btn btn-success btn-sm" 
                                                    @onclick="() => NavigateToQueue(queue.Name)">
                                                <i class="bi bi-eye"></i> Visualizar Mensagens
                                            </button>
                                            <div class="btn-group">
                                                <button class="btn btn-outline-info btn-sm" 
                                                        @onclick="() => ShowSendMessageModal(queue.Url, queue.Name)">
                                                    <i class="bi bi-envelope"></i> Enviar
                                                </button>
                                                <button class="btn btn-outline-warning btn-sm" 
                                                        @onclick="() => ShowSubscribeToSnsModal(queue.Url, queue.Name)">
                                                    <i class="bi bi-link"></i> SNS
                                                </button>
                                                <button class="btn btn-outline-secondary btn-sm" 
                                                        @onclick="() => ShowPurgeQueueModal(queue.Url, queue.Name)"
                                                        disabled="@ReadOnlyService.IsReadOnly">
                                                    <i class="bi bi-trash3"></i> Limpar
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm" 
                                                        @onclick="() => ShowDeleteQueueModal(queue.Url, queue.Name)"
                                                        disabled="@ReadOnlyService.IsReadOnly">
                                                    <i class="bi bi-trash"></i> Excluir
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    @if (totalPages > 1)
                    {
                        <div class="row mt-4">
                            <div class="col-12">
                                <nav aria-label="Paginação de filas">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)">
                                                <i class="bi bi-chevron-left"></i> Anterior
                                            </button>
                                        </li>
                                        
                                        @for (int page = 1; page <= totalPages; page++)
                                        {
                                            var pageNumber = page;
                                            <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                                <button class="page-link" @onclick="() => GoToPage(pageNumber)">
                                                    @pageNumber
                                                </button>
                                            </li>
                                        }
                                        
                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == totalPages)">
                                                Próxima <i class="bi bi-chevron-right"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                                <div class="text-center text-muted">
                                    <small>Página @currentPage de @totalPages (@queues.Count filas no total)</small>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <h4 class="alert-heading">Nenhuma fila encontrada</h4>
                        <p>Não há filas SQS criadas no LocalStack.</p>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        @if (queueDetails != null)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-inbox text-success"></i>
                                    @queueDetails.QueueInfo.Name
                                </h5>
                                <button class="btn btn-outline-danger" @onclick="() => ShowDeleteQueueModal(queueDetails.QueueInfo.Url, queueDetails.QueueInfo.Name)" disabled="@ReadOnlyService.IsReadOnly">
                                    <i class="bi bi-trash"></i> Excluir Fila
                                </button>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <strong>Mensagens:</strong> 
                                    <span class="badge bg-primary">@queueDetails.QueueInfo.ApproximateNumberOfMessages</span>
                                </div>
                                <div class="col-md-3">
                                    <strong>Em Processamento:</strong> 
                                    <span class="badge bg-warning">@queueDetails.QueueInfo.ApproximateNumberOfMessagesNotVisible</span>
                                </div>
                                <div class="col-md-6">
                                    <strong>Criada em:</strong> @queueDetails.QueueInfo.CreatedTimestamp.ToString("dd/MM/yyyy HH:mm:ss")
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-md-8">
                            <small class="text-muted">
                                <strong>URL:</strong> @queueDetails.QueueInfo.Url
                            </small>
                        </div>
                                <div class="col-md-4">
                                    @if (subscribedTopicArns.Any())
                                    {
                                        <small class="text-muted">
                                            <strong>Tópicos Inscritos:</strong>
                                            <div class="mt-1">
                                                @foreach (var topicArn in subscribedTopicArns)
                                                {
                                                    var topicName = GetTopicNameFromArn(topicArn);
                                                    <span class="badge bg-success me-1">@topicName</span>
                                                }
                                            </div>
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">
                                            <strong>Tópicos Inscritos:</strong> Nenhum
                                        </small>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <h4>Mensagens na Fila</h4>
                    @if (queueDetails.Messages.Any())
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Atenção:</strong> As mensagens listadas foram temporariamente recebidas para visualização. 
                            Elas retornarão à fila automaticamente após o timeout de visibilidade.
                        </div>

                        @foreach (var message in queueDetails.Messages)
                        {
                            <div class="card mb-3">
                                <div class="card-header">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <h6 class="mb-0">
                                                <i class="bi bi-envelope"></i>
                                                Mensagem: @message.MessageId[..8]...
                                            </h6>
                                        </div>
                                        <div class="col-md-4 text-end">
                                            <small class="text-muted">
                                                @message.SentTimestamp.ToString("dd/MM/yyyy HH:mm:ss")
                                            </small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <strong>Recebida:</strong> @message.ReceiveCount vez(es)
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Receipt Handle:</strong> 
                                            <code class="small">@message.ReceiptHandle[..20]...</code>
                                        </div>
                                    </div>
                                    
                                    <h6>Conteúdo da Mensagem:</h6>
                                    <div class="bg-light p-3 rounded">
                                        <pre class="mb-0" style="white-space: pre-wrap; word-break: break-word;">@FormatMessageBody(message.Body)</pre>
                                    </div>

                                    @if (message.Attributes.Any())
                                    {
                                        <h6 class="mt-3">Atributos:</h6>
                                        <div class="table-responsive">
                                            <table class="table table-sm">
                                                <thead>
                                                    <tr>
                                                        <th>Atributo</th>
                                                        <th>Valor</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var attr in message.Attributes.Where(a => !IsSystemAttribute(a.Key)))
                                                    {
                                                        <tr>
                                                            <td><code>@attr.Key</code></td>
                                                            <td>@attr.Value</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <h4 class="alert-heading">Nenhuma mensagem disponível</h4>
                            <p>Esta fila não contém mensagens visíveis no momento.</p>
                            <small class="text-muted">
                                Mensagens podem estar sendo processadas ou a fila pode estar vazia.
                            </small>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@if (showCreateQueueModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Criar Nova Fila SQS</h5>
                    <button type="button" class="btn-close" @onclick="HideCreateQueueModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="queueName" class="form-label">Nome da Fila</label>
                        <input type="text" class="form-control" id="queueName" @bind="newQueueName" placeholder="Digite o nome da fila">
                        <div class="form-text">O nome deve ser único e seguir as regras de nomenclatura do SQS.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateQueueModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="CreateQueue" disabled="@(isCreatingQueue || string.IsNullOrWhiteSpace(newQueueName))">
                        @if (isCreatingQueue)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Criar Fila
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showSendMessageModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Enviar Mensagem para @QueueName</h5>
                    <button type="button" class="btn-close" @onclick="HideSendMessageModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="messageSubject" class="form-label">Assunto (Opcional)</label>
                        <input type="text" class="form-control" id="messageSubject" @bind="messageSubject" placeholder="Assunto da mensagem">
                    </div>
                    <div class="mb-3">
                        <label for="messageBody" class="form-label">Corpo da Mensagem</label>
                        <div class="position-relative">
                            <textarea class="form-control font-monospace" 
                                      id="messageBody" 
                                      rows="12" 
                                      @bind="messageBody" 
                                      @oninput="OnMessageBodyInput"
                                      placeholder="Digite o conteúdo da mensagem..."
                                      style="resize: vertical; font-size: 14px; line-height: 1.4;"></textarea>
                            <div class="position-absolute top-0 end-0 p-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="FormatJsonMessage" title="Formatar e organizar JSON">
                                    <i class="bi bi-braces me-1"></i>Formatar JSON
                                </button>
                            </div>
                        </div>
                        <div class="form-text d-flex justify-content-between align-items-center">
                            <span>Você pode enviar texto simples ou JSON.</span>
                            <span class="@(isValidJson ? "text-success" : (jsonValidationMessage != null ? "text-danger" : "text-muted"))">
                                @if (isValidJson)
                                {
                                    <i class="bi bi-check-circle-fill"></i><text> JSON válido</text>
                                }
                                else if (jsonValidationMessage != null)
                                {
                                    <i class="bi bi-exclamation-triangle-fill"></i> @jsonValidationMessage
                                }
                                else
                                {
                                    <span>Caracteres: @messageBody.Length</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideSendMessageModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="SendMessage" disabled="@(isSendingMessage || string.IsNullOrWhiteSpace(messageBody))">
                        @if (isSendingMessage)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Enviar Mensagem
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showSubscribeToSnsModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Inscrever à um tópico</h5>
                    <button type="button" class="btn-close" @onclick="HideSubscribeToSnsModal"></button>
                </div>
                <div class="modal-body">
                    @if (isLoadingTopics)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Carregando tópicos...</span>
                            </div>
                            <p class="mt-2">Carregando tópicos SNS disponíveis...</p>
                        </div>
                    }
                    else if (availableTopics.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label">Tópicos SNS Disponíveis</label>
                            <div class="list-group">
                                @foreach (var topic in availableTopics)
                                {
                                    var isSubscribed = subscribedTopicArns.Contains(topic.Arn);
                                    var isSelected = selectedTopicArns.Contains(topic.Arn);
                                    <div class="list-group-item @(isSubscribed ? "list-group-item-success" : "")"
                                         style="cursor: @(isSubscribed ? "not-allowed" : "pointer")">
                                        <div class="d-flex align-items-center">
                                            <div class="form-check me-3">
                                                <input class="form-check-input" type="checkbox" 
                                                       id="topic-@topic.Arn.GetHashCode()" 
                                                       checked="@isSelected"
                                                       disabled="@isSubscribed"
                                                       @onchange="(e) => ToggleTopicSelection(topic.Arn, (bool)e.Value!)">
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">
                                                    @if (isSubscribed)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-circle me-2"></i>
                                                    }
                                                    @topic.Name
                                                </h6>
                                                <small class="text-muted">@topic.Arn</small>
                                            </div>
                                            @if (isSubscribed)
                                            {
                                                <span class="badge bg-success">Já Inscrito</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="form-text mt-2">
                                @if (subscribedTopicArns.Any())
                                {
                                    <span>Tópicos em verde já estão associados a esta fila. Selecione tópicos não associados para criar novas inscrições.</span>
                                }
                                else
                                {
                                    <span>A fila @QueueName receberá mensagens publicadas nos tópicos selecionados.</span>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <h6>Nenhum tópico SNS encontrado</h6>
                            <p class="mb-0">Crie um tópico SNS primeiro para poder associar esta fila.</p>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideSubscribeToSnsModal">Cancelar</button>
                    <button type="button" class="btn btn-info" @onclick="SubscribeToSnsTopics" 
                            disabled="@(isSubscribing || !selectedTopicArns.Any() || !availableTopics.Any())">
                        @if (isSubscribing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @if (selectedTopicArns.Count == 1)
                        {
                            <span>Inscrever em 1 tópico</span>
                        }
                        else if (selectedTopicArns.Count > 1)
                        {
                            <span>Inscrever em @selectedTopicArns.Count tópicos</span>
                        }
                        else
                        {
                            <span>Inscrever nos tópicos</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteQueueModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Exclusão da Fila</h5>
                    <button type="button" class="btn-close" @onclick="HideDeleteQueueModal"></button>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja excluir a fila <strong>@queueNameToDelete</strong>?</p>
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Atenção:</strong> Esta ação não pode ser desfeita e todas as mensagens serão perdidas!
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideDeleteQueueModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteQueue" disabled="@isDeletingQueue">
                        @if (isDeletingQueue)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Excluir Fila
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showPurgeQueueModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Limpeza da Fila</h5>
                    <button type="button" class="btn-close" @onclick="HidePurgeQueueModal"></button>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja limpar todas as mensagens da fila <strong>@queueNameToPurge</strong>?</p>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Atenção:</strong> Todas as mensagens da fila serão removidas permanentemente!
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HidePurgeQueueModal">Cancelar</button>
                    <button type="button" class="btn btn-warning" @onclick="PurgeQueue" disabled="@isPurgingQueue">
                        @if (isPurgingQueue)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Limpar Fila
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? QueueName { get; set; }

    private List<SqsQueueInfo> queues = new();
    private SqsQueueDetails? queueDetails;
    private bool isLoading = true;
    private bool hasError = false;
    
    private int currentPage = 1;
    private const int itemsPerPage = 6;
    private int totalPages => (int)Math.Ceiling((double)queues.Count / itemsPerPage);
    private List<SqsQueueInfo> paginatedQueues => queues.Skip((currentPage - 1) * itemsPerPage).Take(itemsPerPage).ToList();
    
    private bool showCreateQueueModal = false;
    private string newQueueName = string.Empty;
    private bool isCreatingQueue = false;
    
    private bool showSendMessageModal = false;
    private string messageBody = string.Empty;
    private string messageSubject = string.Empty;
    private bool isSendingMessage = false;
    private string selectedQueueUrl = string.Empty;
    private string selectedQueueName = string.Empty;
    private bool isValidJson = false;
    private string? jsonValidationMessage = null;
    
    private bool showSubscribeToSnsModal = false;
    private List<SnsTopicInfo> availableTopics = new();
    private List<string> subscribedTopicArns = new();
    private List<string> selectedTopicArns = new();
    private bool isSubscribing = false;
    private bool isLoadingTopics = false;
    
    private bool showDeleteQueueModal = false;
    private bool showPurgeQueueModal = false;
    private string queueToDelete = string.Empty;
    private string queueNameToDelete = string.Empty;
    private string queueToPurge = string.Empty;
    private string queueNameToPurge = string.Empty;
    private bool isDeletingQueue = false;
    private bool isPurgingQueue = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(QueueName))
            {
                var result = await LocalStackService.GetSqsQueuesAsync();
                queues = result.IsSuccess && result.Data != null ? result.Data.ToList() : new List<SqsQueueInfo>();
                queueDetails = null;
            }
            else
            {
                var result = await LocalStackService.GetSqsQueueDetailsAsync(QueueName);
                queueDetails = result.IsSuccess ? result.Data : null;
                queues.Clear();
                
                if (queueDetails != null)
                {
                    await LoadSubscribedTopicsForCurrentQueue();
                }
            }
        }
        catch (Exception)
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private async Task NavigateToQueue(string queueName)
    {
        await JSRuntime.InvokeVoidAsync("eval", $"window.location.href = '/sqs/{queueName}'");
    }

    private string FormatMessageBody(string body)
    {
        try
        {
            if (body.TrimStart().StartsWith("{") || body.TrimStart().StartsWith("["))
            {
                var jsonDoc = System.Text.Json.JsonDocument.Parse(body);
                return System.Text.Json.JsonSerializer.Serialize(jsonDoc, new System.Text.Json.JsonSerializerOptions 
                { 
                    WriteIndented = true 
                });
            }
        }
        catch
        {
        }
        
        return body;
    }

    private bool IsSystemAttribute(string attributeName)
    {
        var systemAttributes = new[]
        {
            "SentTimestamp",
            "ApproximateReceiveCount",
            "ApproximateFirstReceiveTimestamp",
            "SenderId"
        };
        
        return systemAttributes.Contains(attributeName);
    }

    private void ShowCreateQueueModal()
    {
        newQueueName = string.Empty;
        showCreateQueueModal = true;
    }

    private void HideCreateQueueModal()
    {
        showCreateQueueModal = false;
        newQueueName = string.Empty;
    }

    private async Task CreateQueue()
    {
        if (string.IsNullOrWhiteSpace(newQueueName))
            return;

        isCreatingQueue = true;
        StateHasChanged();

        try
        {
            var result = await LocalStackService.CreateSqsQueueAsync(newQueueName);
            if (result.IsSuccess)
            {
                HideCreateQueueModal();
                await LoadData();
            }
        }
        finally
        {
            isCreatingQueue = false;
            StateHasChanged();
        }
