    private void ShowSendMessageModal(string queueUrl = "", string queueName = "")
    {
        messageBody = string.Empty;
        messageSubject = string.Empty;
        showSendMessageModal = true;
        
        if (!string.IsNullOrEmpty(queueUrl) && !string.IsNullOrEmpty(queueName))
        {
            selectedQueueUrl = queueUrl;
            selectedQueueName = queueName;
        }
    }

    private void HideSendMessageModal()
    {
        showSendMessageModal = false;
        messageBody = string.Empty;
        messageSubject = string.Empty;
        isValidJson = false;
        jsonValidationMessage = null;
    }

    private async Task SendMessage()
    {
        string queueUrl = "";
        
        if (!string.IsNullOrEmpty(selectedQueueUrl))
        {
            queueUrl = selectedQueueUrl;
        }
        else if (queueDetails != null)
        {
            queueUrl = queueDetails.QueueInfo.Url;
        }
        
        if (string.IsNullOrWhiteSpace(messageBody) || string.IsNullOrEmpty(queueUrl))
            return;

        isSendingMessage = true;
        StateHasChanged();

        try
        {
            var messageAttributes = new Dictionary<string, string>();
            if (!string.IsNullOrWhiteSpace(messageSubject))
            {
                messageAttributes["Subject"] = messageSubject;
            }

            var result = await LocalStackService.SendSqsMessageAsync(queueUrl, messageBody, messageAttributes);
            if (result.IsSuccess)
            {
                HideSendMessageModal();
                await LoadData();
            }
        }
        finally
        {
            isSendingMessage = false;
            StateHasChanged();
        }
    }

    private void OnMessageBodyInput(ChangeEventArgs e)
    {
        messageBody = e.Value?.ToString() ?? string.Empty;
        ValidateJsonSilently();
    }

    private void ValidateJsonSilently()
    {
        if (string.IsNullOrWhiteSpace(messageBody))
        {
            isValidJson = false;
            jsonValidationMessage = null;
            return;
        }

        var trimmed = messageBody.Trim();
        if (!trimmed.StartsWith("{") && !trimmed.StartsWith("["))
        {
            isValidJson = false;
            jsonValidationMessage = null;
            return;
        }

        try
        {
            System.Text.Json.JsonDocument.Parse(messageBody);
            isValidJson = true;
            jsonValidationMessage = null;
        }
        catch (System.Text.Json.JsonException ex)
        {
            isValidJson = false;
            jsonValidationMessage = $"JSON inválido: {ex.Message}";
        }
    }

    private void FormatJsonMessage()
    {
        if (string.IsNullOrWhiteSpace(messageBody))
            return;

        try
        {
            var jsonDoc = System.Text.Json.JsonDocument.Parse(messageBody);
            messageBody = System.Text.Json.JsonSerializer.Serialize(jsonDoc, new System.Text.Json.JsonSerializerOptions 
            { 
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
            ValidateJsonSilently();
            StateHasChanged();
        }
        catch (System.Text.Json.JsonException ex)
        {
            jsonValidationMessage = $"Erro ao formatar: {ex.Message}";
            isValidJson = false;
            StateHasChanged();
        }
    }


    private async Task ShowSubscribeToSnsModal(string queueUrl = "", string queueName = "")
    {
        selectedTopicArns.Clear();
        availableTopics.Clear();
        showSubscribeToSnsModal = true;
        
        if (!string.IsNullOrEmpty(queueUrl) && !string.IsNullOrEmpty(queueName))
        {
            selectedQueueUrl = queueUrl;
            selectedQueueName = queueName;
        }
        
        await LoadAvailableTopics();
    }

    private void HideSubscribeToSnsModal()
    {
        showSubscribeToSnsModal = false;
        selectedTopicArns.Clear();
        availableTopics.Clear();
    }

    private async Task LoadAvailableTopics()
    {
        isLoadingTopics = true;
        StateHasChanged();

        try
        {
            var result = await LocalStackService.GetSnsTopicsAsync();
            if (result.IsSuccess && result.Data != null)
            {
                availableTopics = result.Data.ToList();
            }
            
            await LoadSubscribedTopics();
        }
        finally
        {
            isLoadingTopics = false;
            StateHasChanged();
        }
    }

    private async Task LoadSubscribedTopics()
    {
        subscribedTopicArns.Clear();
        
        string queueUrl = "";
        if (queueDetails != null)
        {
            queueUrl = queueDetails.QueueInfo.Url;
        }
        else if (!string.IsNullOrEmpty(selectedQueueUrl))
        {
            queueUrl = selectedQueueUrl;
        }
        
        if (string.IsNullOrEmpty(queueUrl)) return;
        
        try
        {
            var queueArn = ConvertQueueUrlToArn(queueUrl);
            
            foreach (var topic in availableTopics)
            {
                var subscriptionsResult = await LocalStackService.GetSnsSubscriptionsAsync(topic.Arn);
                if (subscriptionsResult.IsSuccess && subscriptionsResult.Data != null)
                {
                    var isSubscribed = subscriptionsResult.Data.Any(s => s.Endpoint == queueArn);
                    
                    if (isSubscribed)
                    {
                        subscribedTopicArns.Add(topic.Arn);
                    }
                }
            }
        }
        catch (Exception)
        {
        }
    }

    private async Task LoadSubscribedTopicsForCurrentQueue()
    {
        subscribedTopicArns.Clear();
        
        if (queueDetails == null) return;
        
        try
        {
            var topicsResult = await LocalStackService.GetSnsTopicsAsync();
            if (topicsResult.IsSuccess && topicsResult.Data != null)
            {
                var queueArn = ConvertQueueUrlToArn(queueDetails.QueueInfo.Url);
                
                foreach (var topic in topicsResult.Data)
                {
                    var subscriptionsResult = await LocalStackService.GetSnsSubscriptionsAsync(topic.Arn);
                    if (subscriptionsResult.IsSuccess && subscriptionsResult.Data != null)
                    {
                        var isSubscribed = subscriptionsResult.Data.Any(s => s.Endpoint == queueArn);
                        
                        if (isSubscribed)
                        {
                            subscribedTopicArns.Add(topic.Arn);
                        }
                    }
                }
            }
        }
        catch (Exception)
        {
        }
    }

    private void ToggleTopicSelection(string topicArn, bool isSelected)
    {
        if (isSelected)
        {
            if (!selectedTopicArns.Contains(topicArn))
            {
                selectedTopicArns.Add(topicArn);
            }
        }
        else
        {
            selectedTopicArns.Remove(topicArn);
        }
        StateHasChanged();
    }

    private string GetTopicNameFromArn(string topicArn)
    {
        if (string.IsNullOrEmpty(topicArn)) return string.Empty;
        
        var parts = topicArn.Split(':');
        return parts.Length > 0 ? parts[^1] : topicArn;
    }

    private string ConvertQueueUrlToArn(string queueUrl)
    {
        if (string.IsNullOrEmpty(queueUrl)) return string.Empty;
        
        var parts = queueUrl.Split('/');
        if (parts.Length >= 3)
        {
            var accountId = parts[^2];
            var queueName = parts[^1];
            return $"arn:aws:sqs:us-west-2:{accountId}:{queueName}";
        }
        
        return queueUrl;
    }

    private async Task SubscribeToSnsTopics()
    {
        if (!selectedTopicArns.Any())
            return;

        string queueUrl = "";
        if (queueDetails != null)
        {
            queueUrl = queueDetails.QueueInfo.Url;
        }
        else if (!string.IsNullOrEmpty(selectedQueueUrl))
        {
            queueUrl = selectedQueueUrl;
        }
        
        if (string.IsNullOrEmpty(queueUrl))
            return;

        isSubscribing = true;
        StateHasChanged();

        try
        {
            var queueArn = ConvertQueueUrlToArn(queueUrl);
            
            foreach (var topicArn in selectedTopicArns)
            {
                var result = await LocalStackService.SubscribeSnsAsync(topicArn, "sqs", queueArn);
            if (result.IsSuccess)
            {
                    if (!subscribedTopicArns.Contains(topicArn))
                    {
                        subscribedTopicArns.Add(topicArn);
                    }
                }
            }
            
                HideSubscribeToSnsModal();
                await LoadData();
        }
        finally
        {
            isSubscribing = false;
            StateHasChanged();
        }
    }

    private void ShowDeleteQueueModal(string queueUrl, string queueName)
    {
        queueToDelete = queueUrl;
        queueNameToDelete = queueName;
        showDeleteQueueModal = true;
    }

    private void HideDeleteQueueModal()
    {
        showDeleteQueueModal = false;
        queueToDelete = string.Empty;
        queueNameToDelete = string.Empty;
    }

    private async Task DeleteQueue()
    {
        if (string.IsNullOrEmpty(queueToDelete))
            return;

        isDeletingQueue = true;
        StateHasChanged();

        try
        {
            var result = await LocalStackService.DeleteSqsQueueAsync(queueToDelete);
            if (result.IsSuccess)
            {
                HideDeleteQueueModal();
                if (!string.IsNullOrEmpty(QueueName) && queueDetails?.QueueInfo.Name == queueNameToDelete)
                {
                    Navigation.NavigateTo("/sqs", forceLoad: true);
                }
                else
                {
                    await LoadData();
                }
            }
        }
        finally
        {
            isDeletingQueue = false;
            StateHasChanged();
        }
    }

