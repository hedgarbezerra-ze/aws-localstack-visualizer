@page "/s3"
@page "/s3/{BucketName?}"
@using AwsLocalStackVisualizer.Abstractions
@using AwsLocalStackVisualizer.Models.S3
@using AwsLocalStackVisualizer.Models.Common
@using AwsLocalStackVisualizer.Services
@using AwsLocalStackVisualizer.Configuration
@using AwsLocalStackVisualizer.Validators
@using Microsoft.AspNetCore.Components.Forms
@inject ILocalStackService LocalStackService
@inject IReadOnlyService ReadOnlyService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject AwsRegionContext RegionContext
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>S3 Browser - LocalStack Visualizer</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5">
                        S3 Buckets
                    </h1>
                    @if (!string.IsNullOrEmpty(BucketName))
                    {
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/s3" class="text-decoration-none">Buckets</a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">@BucketName</li>
                            </ol>
                        </nav>
                    }
                </div>
                <div class="btn-group">
                    @if (string.IsNullOrEmpty(BucketName))
                    {
                        <button class="btn btn-success" @onclick="ShowCreateBucketModal" disabled="@ReadOnlyService.IsReadOnly">
                            <i class="bi bi-plus-circle"></i> Criar Bucket
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="ShowUploadObjectModal" disabled="@ReadOnlyService.IsReadOnly">
                            <i class="bi bi-upload"></i> Enviar Arquivo
                        </button>
                    }
                    <button class="btn btn-outline-primary" @onclick="RefreshData">
                        <i class="bi bi-arrow-clockwise"></i> Atualizar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="row">
            <div class="col-12 text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
                <p class="mt-2">Carregando dados do S3...</p>
            </div>
        </div>
    }
    else if (hasError)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Erro ao carregar dados</h4>
                    <p>Não foi possível conectar ao serviço S3 do LocalStack.</p>
                    <button class="btn btn-outline-danger" @onclick="RefreshData">
                        <i class="bi bi-arrow-clockwise"></i> Tentar Novamente
                    </button>
                </div>
            </div>
        </div>
    }
    else if (string.IsNullOrEmpty(BucketName))
    {
        <div class="row">
            <div class="col-12">
                <h3>Buckets Disponíveis</h3>
                @if (buckets.Any())
                {
                    <div class="row">
                        @foreach (var bucket in paginatedBuckets)
                        {
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <i class="bi bi-bucket text-primary"></i>
                                            @bucket.Name
                                        </h5>
                                        <div class="row text-center">
                                            <div class="col-6">
                                                <h6 class="text-primary mb-0">@bucket.ObjectCount</h6>
                                                <small class="text-muted">Objetos</small>
                                            </div>
                                            <div class="col-6">
                                                <h6 class="text-success mb-0">@FormatBytes(bucket.TotalSize)</h6>
                                                <small class="text-muted">Tamanho</small>
                                            </div>
                                        </div>
                                        <hr>
                                        <small class="text-muted">
                                            Criado em: @bucket.CreationDate.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                    <div class="card-footer">
                                        <div class="btn-group w-100">
                                            <button class="btn btn-primary btn-sm" 
                                                    @onclick="() => NavigateToBucket(bucket.Name)">
                                                <i class="bi bi-eye"></i> Visualizar
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" 
                                                    @onclick="() => ShowDeleteBucketModal(bucket.Name)"
                                                    disabled="@ReadOnlyService.IsReadOnly">
                                                <i class="bi bi-trash"></i> Excluir
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    @if (totalPages > 1)
                    {
                        <div class="row mt-4">
                            <div class="col-12">
                                <nav aria-label="Paginação de buckets">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)">
                                                <i class="bi bi-chevron-left"></i> Anterior
                                            </button>
                                        </li>
                                        
                                        @for (int page = 1; page <= totalPages; page++)
                                        {
                                            var pageNumber = page;
                                            <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                                <button class="page-link" @onclick="() => GoToPage(pageNumber)">
                                                    @pageNumber
                                                </button>
                                            </li>
                                        }
                                        
                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == totalPages)">
                                                Próxima <i class="bi bi-chevron-right"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                                <div class="text-center text-muted">
                                    <small>Página @currentPage de @totalPages (@buckets.Count buckets no total)</small>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <h4 class="alert-heading">Nenhum bucket encontrado</h4>
                        <p>Não há buckets S3 criados no LocalStack.</p>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        @if (bucketDetails != null)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-bucket text-primary"></i>
                                    @bucketDetails.BucketInfo.Name
                                </h5>
                                <button class="btn btn-outline-danger" @onclick="() => ShowDeleteBucketModal(bucketDetails.BucketInfo.Name)" disabled="@ReadOnlyService.IsReadOnly">
                                    <i class="bi bi-trash"></i> Excluir Bucket
                                </button>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <strong>Objetos:</strong> @bucketDetails.BucketInfo.ObjectCount
                                </div>
                                <div class="col-md-3">
                                    <strong>Tamanho Total:</strong> @FormatBytes(bucketDetails.BucketInfo.TotalSize)
                                </div>
                                <div class="col-md-6">
                                    <strong>Criado em:</strong> @bucketDetails.BucketInfo.CreationDate.ToString("dd/MM/yyyy HH:mm:ss")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <h4>Objetos no Bucket</h4>
                    @if (bucketDetails.Objects.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 35%;">Nome</th>
                                        <th style="width: 12%;">Tamanho</th>
                                        <th style="width: 18%;">Última Modificação</th>
                                        <th style="width: 12%;">Classe</th>
                                        <th style="width: 23%;">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var obj in bucketDetails.Objects)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="@GetFileIcon(obj.Key) text-primary me-2"></i>
                                                    <span class="text-break">@obj.Key</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark">@FormatBytes(obj.Size)</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">@obj.LastModified.ToString("dd/MM/yyyy")</small><br>
                                                <small class="text-muted">@obj.LastModified.ToString("HH:mm:ss")</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@obj.StorageClass</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm btn-outline-success" 
                                                            @onclick="() => DownloadObject(obj.Key)">
                                                        <i class="bi bi-download"></i> Download
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" 
                                                            @onclick="() => ShowDeleteObjectModal(obj.Key)"
                                                            disabled="@ReadOnlyService.IsReadOnly">
                                                        <i class="bi bi-trash"></i> Excluir
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <h4 class="alert-heading">Bucket vazio</h4>
                            <p>Este bucket não contém nenhum objeto.</p>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>


@if (showCreateBucketModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Criar Novo Bucket</h5>
                    <button type="button" class="btn-close" @onclick="HideCreateBucketModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="bucketName" class="form-label">Nome do Bucket</label>
                        <input type="text" 
                               class="form-control @(bucketValidationResult?.IsValid == false ? "is-invalid" : "")" 
                               id="bucketName" 
                               @bind="newBucketName" 
                               @oninput="ValidateBucketName"
                               placeholder="Digite o nome do bucket">
                        
                        @if (bucketValidationResult != null && !bucketValidationResult.IsValid)
                        {
                            <div class="invalid-feedback">
                                @bucketValidationResult.Message
                            </div>
                        }
                        else if (bucketValidationResult?.IsValid == true)
                        {
                            <div class="valid-feedback d-block">
                                ✓ Nome do bucket é válido
                            </div>
                        }
                        
                        <div class="form-text mt-2">
                            <small>
                                <strong>Regras de nomenclatura:</strong><br/>
                                • 3-63 caracteres (apenas letras minúsculas, números e hífens)<br/>
                                • Deve começar e terminar com letra ou número<br/>
                                • Não pode conter dois hífens consecutivos<br/>
                                • Não pode ser um endereço IP
                            </small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateBucketModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="CreateBucket" disabled="@(isCreatingBucket || string.IsNullOrWhiteSpace(newBucketName) || bucketValidationResult?.IsValid != true)">
                        @if (isCreatingBucket)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Criar Bucket
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showUploadObjectModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Enviar Arquivo para @BucketName</h5>
                    <button type="button" class="btn-close" @onclick="HideUploadObjectModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="objectKey" class="form-label">Nome do Arquivo</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="objectKey" @bind="newObjectName" placeholder="exemplo" @oninput="OnObjectNameChanged">
                            <span class="input-group-text bg-light">@GetFileExtension()</span>
                        </div>
                    </div>
                    
                    
                    <div class="mb-3">
                        <label class="form-label">Selecionar Arquivo</label>
                        <InputFile OnChange="HandleInputFileSelected" class="form-control" accept="*/*" />
                        @if (!string.IsNullOrEmpty(selectedFileName))
                        {
                            <div class="mt-2 p-2 bg-light rounded">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <i class="bi bi-file-earmark me-2"></i>
                                        <strong>@selectedFileName</strong>
                                        @if (selectedFileSize > 0)
                                        {
                                            <small class="text-muted ms-2">(@FormatBytes(selectedFileSize))</small>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearSelectedFile">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                                @if (!string.IsNullOrEmpty(detectedContentType))
                                {
                                    <small class="text-muted d-block mt-1">Tipo detectado: @detectedContentType</small>
                                }
                            </div>
                        }
                    </div>
                    
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideUploadObjectModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="UploadObject" disabled="@(isUploadingObject || string.IsNullOrWhiteSpace(newObjectKey) || (selectedFile is null && string.IsNullOrWhiteSpace(newObjectContent)))">
                        @if (isUploadingObject)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Enviar Arquivo
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteBucketModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Exclusão do Bucket</h5>
                    <button type="button" class="btn-close" @onclick="HideDeleteBucketModal"></button>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja excluir o bucket <strong>@bucketToDelete</strong>?</p>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="forceDeleteBucket" id="forceDeleteBucket">
                        <label class="form-check-label" for="forceDeleteBucket">
                            Forçar exclusão (remover todos os objetos primeiro)
                        </label>
                    </div>
                    <div class="alert alert-warning mt-2">
                        <i class="bi bi-exclamation-triangle"></i>
                        Esta ação não pode ser desfeita!
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideDeleteBucketModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteBucket" disabled="@isDeletingBucket">
                        @if (isDeletingBucket)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Excluir Bucket
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteObjectModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Exclusão do Objeto</h5>
                    <button type="button" class="btn-close" @onclick="HideDeleteObjectModal"></button>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja excluir o objeto <strong>@objectToDelete</strong>?</p>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Esta ação não pode ser desfeita!
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideDeleteObjectModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteObject" disabled="@isDeletingObject">
                        @if (isDeletingObject)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Excluir Objeto
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? BucketName { get; set; }

    private List<S3BucketInfo> buckets = new();
    private S3BucketDetails? bucketDetails;
    private bool isLoading = true;
    private bool hasError = false;
    
    private int currentPage = 1;
    private const int itemsPerPage = 6;
    private int totalPages => (int)Math.Ceiling((double)buckets.Count / itemsPerPage);
    private List<S3BucketInfo> paginatedBuckets => buckets.Skip((currentPage - 1) * itemsPerPage).Take(itemsPerPage).ToList();
    
    private bool showCreateBucketModal = false;
    private string newBucketName = string.Empty;
    private bool isCreatingBucket = false;
    private ValidationResult? bucketValidationResult = null;
    
    private bool showUploadObjectModal = false;
    private string newObjectKey = string.Empty;
    private string newObjectName = string.Empty;
    private string newObjectContent = string.Empty;
    private string newObjectContentType = "text/plain";
    private string detectedContentType = string.Empty;
    private bool isUploadingObject = false;
    
    private string selectedFileName = string.Empty;
    private string selectedFileExtension = string.Empty;
    private long selectedFileSize = 0;
    private IBrowserFile? selectedFile = null;
    private byte[]? fileData = null;
    
    private bool showDeleteBucketModal = false;
    private bool showDeleteObjectModal = false;
    private string bucketToDelete = string.Empty;
    private string objectToDelete = string.Empty;
    private bool isDeletingBucket = false;
    private bool isDeletingObject = false;
    private bool forceDeleteBucket = false;

    protected override void OnInitialized()
    {
        RegionContext.RegionChanged += OnRegionChangedRefreshContent;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private void OnRegionChangedRefreshContent()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        RegionContext.RegionChanged -= OnRegionChangedRefreshContent;
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(BucketName))
            {
                await LoadBucketsAsync();
            }
            else
            {
                var result = await LocalStackService.GetS3BucketDetailsAsync(BucketName);
                bucketDetails = result.IsSuccess ? result.Data : null;
                buckets.Clear();
            }
        }
        catch (Exception)
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadBucketsAsync()
    {
        var result = await LocalStackService.GetS3BucketsAsync();
        buckets = result.IsSuccess && result.Data != null ? result.Data.ToList() : new List<S3BucketInfo>();
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private async Task NavigateToBucket(string bucketName)
    {
        await JSRuntime.InvokeVoidAsync("eval", $"window.location.href = '/s3/{bucketName}'");
    }

    private async Task DownloadObject(string objectKey)
    {
        try
        {
            var result = await LocalStackService.DownloadObjectAsync(BucketName!, objectKey);
            
            if (result.IsSuccess && result.Data != null)
            {
                var extension = Path.GetExtension(objectKey).ToLower();
                var mimeType = GetMimeTypeFromExtension(extension);
                var base64Data = Convert.ToBase64String(result.Data);
                
                await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", objectKey, base64Data, mimeType);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Erro ao baixar arquivo: {result.ErrorMessage ?? "Erro desconhecido"}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao baixar arquivo: {ex.Message}");
        }
    }

    private string GetMimeTypeFromExtension(string extension)
    {
        if (string.IsNullOrEmpty(extension))
            return "application/octet-stream";
            
        return extension switch
        {
            ".txt" or ".log" => "text/plain",
            ".html" or ".htm" => "text/html",
            ".css" => "text/css",
            ".json" => "application/json",
            ".xml" => "application/xml",
            ".js" => "application/javascript",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".svg" => "image/svg+xml",
            ".pdf" => "application/pdf",
            ".zip" => "application/zip",
            _ => "application/octet-stream"
        };
    }

    private string FormatBytes(long bytes)
    {
        if (bytes == 0) return "0 B";
        
        string[] suffixes = { "B", "KB", "MB", "GB", "TB" };
        int suffixIndex = 0;
        double size = bytes;
        
        while (size >= 1024 && suffixIndex < suffixes.Length - 1)
        {
            size /= 1024;
            suffixIndex++;
        }
        
        return $"{size:F2} {suffixes[suffixIndex]}";
    }

    private string GetFileIcon(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLower();
        return extension switch
        {
            ".txt" or ".log" or ".md" or ".markdown" => "bi bi-file-text",
            
            ".json" or ".xml" or ".js" or ".ts" or ".yml" or ".yaml" => "bi bi-file-code",
            ".html" or ".htm" => "bi bi-filetype-html",
            ".css" => "bi bi-filetype-css",
            
            ".csv" or ".xls" or ".xlsx" => "bi bi-file-spreadsheet",
            
            ".pdf" => "bi bi-file-pdf",
            ".doc" or ".docx" => "bi bi-file-word",
            
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".svg" => "bi bi-file-image",
            
            ".mp3" or ".wav" => "bi bi-file-music",
            ".mp4" or ".webm" or ".avi" or ".mov" => "bi bi-file-play",
            
            ".zip" or ".rar" or ".7z" or ".tar" or ".gz" => "bi bi-file-zip",
            
            _ => "bi bi-file-earmark"
        };
    }

    private void ShowCreateBucketModal()
    {
        newBucketName = string.Empty;
        showCreateBucketModal = true;
    }

    private void HideCreateBucketModal()
    {
        showCreateBucketModal = false;
        newBucketName = string.Empty;
        bucketValidationResult = null;
    }

    private void ValidateBucketName(ChangeEventArgs e)
    {
        var bucketName = e.Value?.ToString() ?? string.Empty;
        newBucketName = bucketName;
        bucketValidationResult = S3BucketValidator.ValidateBucketName(bucketName);
        StateHasChanged();
    }

    private async Task CreateBucket()
    {
        if (string.IsNullOrWhiteSpace(newBucketName))
            return;

        var validation = S3BucketValidator.ValidateBucketName(newBucketName);
        if (!validation.IsValid)
        {
            bucketValidationResult = validation;
            StateHasChanged();
            return;
        }

        isCreatingBucket = true;
        StateHasChanged();

        try
        {
            var result = await LocalStackService.CreateS3BucketAsync(newBucketName);
            if (result.IsSuccess)
            {
                HideCreateBucketModal();
                await LoadData();
            }
        }
        finally
        {
            isCreatingBucket = false;
            StateHasChanged();
        }
    }

    private void ShowUploadObjectModal()
    {
        newObjectKey = string.Empty;
        newObjectName = string.Empty;
        newObjectContent = string.Empty;
        newObjectContentType = "text/plain";
        detectedContentType = string.Empty;
        selectedFileName = string.Empty;
        selectedFileExtension = string.Empty;
        selectedFileSize = 0;
        selectedFile = null;
        fileData = null;
        showUploadObjectModal = true;
    }

    private void HideUploadObjectModal()
    {
        showUploadObjectModal = false;
        newObjectKey = string.Empty;
        newObjectName = string.Empty;
        newObjectContent = string.Empty;
        newObjectContentType = "text/plain";
        detectedContentType = string.Empty;
        selectedFileName = string.Empty;
        selectedFileExtension = string.Empty;
        selectedFileSize = 0;
        selectedFile = null;
        fileData = null;
    }




    [JSInvokable]
    public void SetFileContent(string fileName, string content, string? binaryDataBase64 = null)
    {
        
        if (string.IsNullOrEmpty(newObjectKey))
        {
            newObjectKey = fileName;
        }
        
        newObjectContent = content;
        
        if (!string.IsNullOrEmpty(binaryDataBase64))
        {
            try
            {
                fileData = Convert.FromBase64String(binaryDataBase64);
            }
            catch
            {
                fileData = null;
            }
        }
        else
        {
            fileData = null;
        }
        
        var extension = Path.GetExtension(fileName).ToLower();
        detectedContentType = GetMimeTypeFromExtension(extension);
        
        if (newObjectContentType == "text/plain")
        {
            newObjectContentType = detectedContentType;
        }
        
        StateHasChanged();
    }

    private async Task HandleInputFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            selectedFile = e.File;
            selectedFileName = selectedFile.Name;
            selectedFileSize = selectedFile.Size;
            
            var extension = Path.GetExtension(selectedFileName).ToLower();
            selectedFileExtension = extension;
            
            if (string.IsNullOrEmpty(newObjectName))
            {
                newObjectName = Path.GetFileNameWithoutExtension(selectedFileName);
            }
            
            UpdateObjectKey();
            
            detectedContentType = GetMimeTypeFromExtension(extension);
            newObjectContentType = detectedContentType;
            
            fileData = null;
            newObjectContent = string.Empty;
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao processar arquivo: {ex.Message}");
            ClearSelectedFile();
        }
    }
    
    private void ClearSelectedFile()
    {
        selectedFile = null;
        selectedFileName = string.Empty;
        selectedFileExtension = string.Empty;
        selectedFileSize = 0;
        detectedContentType = string.Empty;
        fileData = null;
        newObjectContent = string.Empty;
        StateHasChanged();
    }



    private void OnObjectNameChanged(ChangeEventArgs e)
    {
        newObjectName = e.Value?.ToString() ?? string.Empty;
        UpdateObjectKey();
    }

    private void UpdateObjectKey()
    {
        if (string.IsNullOrEmpty(newObjectName))
        {
            newObjectKey = string.Empty;
        }
        else
        {
            newObjectKey = newObjectName + GetFileExtension();
        }
    }

    private string GetFileExtension()
    {
        return selectedFileExtension;
    }

    private async Task UploadObject()
    {
        if (string.IsNullOrWhiteSpace(newObjectKey) || string.IsNullOrWhiteSpace(BucketName))
            return;

        if (selectedFile is null && string.IsNullOrWhiteSpace(newObjectContent))
            return;

        isUploadingObject = true;
        StateHasChanged();

        try
        {
            OperationResult<bool> result;

            if (selectedFile is not null)
            {
                const int maxFileSize = 200 * 1024 * 1024; // 200MB
                
                if (selectedFile.Size > maxFileSize)
                {
                    var maxSizeMB = maxFileSize / (1024 * 1024);
                    var fileSizeMB = selectedFile.Size / (1024 * 1024);
                    
                    await JSRuntime.InvokeVoidAsync("alert", $"Arquivo muito grande! Tamanho: {fileSizeMB:F1}MB. Máximo permitido: {maxSizeMB}MB");
                    return;
                }
                
                using var stream = selectedFile.OpenReadStream(maxFileSize);
                result = await LocalStackService.UploadFileAsync(BucketName, newObjectKey, stream, newObjectContentType);
            }
            else
            {
                result = await LocalStackService.UploadS3ObjectAsync(BucketName, newObjectKey, newObjectContent, newObjectContentType);
            }
            
            if (result.IsSuccess)
            {
                HideUploadObjectModal();
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Erro ao enviar arquivo: {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro inesperado: {ex.Message}");
        }
        finally
        {
            isUploadingObject = false;
            StateHasChanged();
        }
    }

    private void ShowDeleteBucketModal(string bucketName)
    {
        bucketToDelete = bucketName;
        forceDeleteBucket = false;
        showDeleteBucketModal = true;
    }

    private void HideDeleteBucketModal()
    {
        showDeleteBucketModal = false;
        bucketToDelete = string.Empty;
        forceDeleteBucket = false;
    }

    private async Task DeleteBucket()
    {
        if (string.IsNullOrWhiteSpace(bucketToDelete))
            return;

        isDeletingBucket = true;
        StateHasChanged();

        try
        {
            var result = await LocalStackService.DeleteS3BucketAsync(bucketToDelete, forceDeleteBucket);
            if (result.IsSuccess)
            {
                HideDeleteBucketModal();
                if (!string.IsNullOrEmpty(BucketName) && BucketName == bucketToDelete)
                {
                    Navigation.NavigateTo("/s3", forceLoad: true);
                }
                else
                {
                    await LoadData();
                }
            }
        }
        finally
        {
            isDeletingBucket = false;
            StateHasChanged();
        }
    }

    private void ShowDeleteObjectModal(string objectKey)
    {
        objectToDelete = objectKey;
        showDeleteObjectModal = true;
    }

    private void HideDeleteObjectModal()
    {
        showDeleteObjectModal = false;
        objectToDelete = string.Empty;
    }

    private async Task DeleteObject()
    {
        if (string.IsNullOrWhiteSpace(objectToDelete) || string.IsNullOrWhiteSpace(BucketName))
            return;

        isDeletingObject = true;
        StateHasChanged();

        try
        {
            var result = await LocalStackService.DeleteS3ObjectAsync(BucketName, objectToDelete);
            if (result.IsSuccess)
            {
                HideDeleteObjectModal();
                await LoadData();
            }
        }
        finally
        {
            isDeletingObject = false;
            StateHasChanged();
        }
    }
}

<script>
    window.showModal = (modalId) => {
        const modalElement = document.getElementById(modalId);
        if (modalElement) {
            const modal = new bootstrap.Modal(modalElement);
            modal.show();
        }
    };

    window.downloadFileFromBase64 = (fileName, base64Data, mimeType) => {
        try {
            const byteCharacters = atob(base64Data);
            const byteNumbers = new Array(byteCharacters.length);
            for (let i = 0; i < byteCharacters.length; i++) {
                byteNumbers[i] = byteCharacters.charCodeAt(i);
            }
            const byteArray = new Uint8Array(byteNumbers);
            
            const blob = new Blob([byteArray], { type: mimeType });
            const url = window.URL.createObjectURL(blob);
            
            const downloadLink = document.createElement('a');
            downloadLink.href = url;
            downloadLink.download = fileName;
            downloadLink.style.display = 'none';
            
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
            
            window.URL.revokeObjectURL(url);
        } catch (error) {
            console.error('Erro ao fazer download:', error);
            alert('Erro ao fazer download do arquivo: ' + error.message);
        }
    };

    window.handleFileDrop = (dotNetRef) => {
        const fileInput = document.querySelector('input[type=file]');
        if (fileInput && fileInput.files && fileInput.files[0]) {
            const file = fileInput.files[0];
            readFileAsAppropriate(file, dotNetRef);
        }
    };

    window.readFileContent = (dotNetRef) => {
        const fileInput = document.querySelector('input[type=file]');
        if (fileInput && fileInput.files && fileInput.files[0]) {
            const file = fileInput.files[0];
            readFileAsAppropriate(file, dotNetRef);
        }
    };

    function readFileAsAppropriate(file, dotNetRef) {
        const reader = new FileReader();
        
        const isSmallTextFile = file.size < 64 * 1024 && // Apenas arquivos menores que 64KB
                               (file.type.startsWith('text/') || 
                                file.name.match(/\.(txt|log|json|xml|html|css|js|md)$/i));
        
        if (isSmallTextFile) {
            reader.onload = function(e) {
                dotNetRef.invokeMethodAsync('SetFileContent', file.name, e.target.result, null);
            };
            reader.onerror = function(error) {
                console.error('Erro ao ler arquivo como texto:', error);
               readAsBinary(file, dotNetRef);
            };
            reader.readAsText(file);
        } else {
            readAsBinary(file, dotNetRef);
        }
    }
    
    function readAsBinary(file, dotNetRef) {
        const reader = new FileReader();
        
        reader.onload = function(e) {
            try {
                const dataUrl = e.target.result;
                if (dataUrl && dataUrl.includes(',')) {
                    const base64 = dataUrl.split(',')[1];
                    dotNetRef.invokeMethodAsync('SetFileContent', file.name, '', base64);
                } else {
                    console.error('Erro: formato de dados inválido');
                    alert('Erro ao processar o arquivo. Formato inválido.');
                }
            } catch (error) {
                console.error('Erro ao processar arquivo binário:', error);
                alert('Erro ao processar o arquivo: ' + error.message);
            }
        };
        
        reader.onerror = function(error) {
            console.error('Erro ao ler arquivo binário:', error);
            alert('Erro ao ler o arquivo. Verifique se o arquivo não está corrompido.');
        };
        
        reader.readAsDataURL(file);
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.addEventListener('dragover', function(e) {
            const dropZone = e.target.closest('.border-dashed');
            if (dropZone) {
                e.preventDefault();
                dropZone.classList.add('border-primary', 'bg-light');
            }
        });

        document.addEventListener('dragleave', function(e) {
            const dropZone = e.target.closest('.border-dashed');
            if (dropZone && !dropZone.contains(e.relatedTarget)) {
                dropZone.classList.remove('border-primary', 'bg-light');
            }
        });

        document.addEventListener('drop', function(e) {
            const dropZone = e.target.closest('.border-dashed');
            if (dropZone) {
                e.preventDefault();
                dropZone.classList.remove('border-primary', 'bg-light');
                
                const files = e.dataTransfer.files;
                if (files && files[0]) {
                    const fileInput = document.querySelector('input[type=file]');
                    if (fileInput) {
                        fileInput.files = files;
                        const event = new Event('change', { bubbles: true });
                        fileInput.dispatchEvent(event);
                    }
                }
            }
        });
    });
</script>
