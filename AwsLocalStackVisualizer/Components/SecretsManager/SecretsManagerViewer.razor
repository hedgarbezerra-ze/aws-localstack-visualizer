@page "/secrets"
@using AwsLocalStackVisualizer.Models
@using AwsLocalStackVisualizer.Services
@inject ILocalStackService LocalStackService
@inject INotificationService NotificationService
@implements IDisposable

<PageTitle>Secrets Manager</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">AWS Secrets Manager</h1>
                <div>
                    <button class="btn btn-primary me-2" @onclick="ShowCreateSecretModal">
                        <i class="fas fa-plus"></i> Criar Secret
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="RefreshSecrets">
                        <i class="fas fa-sync-alt"></i> Atualizar
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                </div>
            }
            else if (secrets.Any())
            {
                <div class="row">
                    @foreach (var secret in secrets)
                    {
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title text-truncate" title="@secret.Name">@secret.Name</h5>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><button class="dropdown-item" @onclick="() => ViewSecret(secret.Name)">
                                                    <i class="fas fa-eye"></i> Visualizar
                                                </button></li>
                                                <li><button class="dropdown-item" @onclick="() => ShowUpdateSecretModal(secret.Name)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><button class="dropdown-item text-danger" @onclick="() => ShowDeleteConfirmation(secret.Name)">
                                                    <i class="fas fa-trash"></i> Excluir
                                                </button></li>
                                            </ul>
                                        </div>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(secret.Description))
                                    {
                                        <p class="card-text text-muted small">@secret.Description</p>
                                    }
                                    
                                    <div class="small text-muted">
                                        <div><strong>Criado:</strong> @secret.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                                        @if (secret.LastChangedDate.HasValue)
                                        {
                                            <div><strong>Modificado:</strong> @secret.LastChangedDate.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                        @if (secret.Tags.Any())
                                        {
                                            <div class="mt-2">
                                                @foreach (var tag in secret.Tags.Take(3))
                                                {
                                                    <span class="badge bg-secondary me-1">@tag.Key: @tag.Value</span>
                                                }
                                                @if (secret.Tags.Count > 3)
                                                {
                                                    <span class="text-muted">+@(secret.Tags.Count - 3) mais</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-key fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Nenhum secret encontrado</h4>
                    <p class="text-muted">Crie seu primeiro secret para começar</p>
                    <button class="btn btn-primary" @onclick="ShowCreateSecretModal">
                        <i class="fas fa-plus"></i> Criar Secret
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para criar/editar secret -->
@if (showSecretModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Editar Secret" : "Criar Secret")</h5>
                    <button type="button" class="btn-close" @onclick="CloseSecretModal"></button>
                </div>
                <div class="modal-body">
                    <form @onsubmit="SaveSecret" @onsubmit:preventDefault="true">
                        <div class="mb-3">
                            <label class="form-label">Nome do Secret</label>
                            <input type="text" class="form-control" @bind="secretForm.Name" 
                                   placeholder="meu-secret" disabled="@isEditMode" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Valor do Secret</label>
                            <textarea class="form-control" rows="4" @bind="secretForm.Value" 
                                      placeholder="Valor do secret (JSON, string, etc.)" required></textarea>
                        </div>
                        @if (!isEditMode)
                        {
                            <div class="mb-3">
                                <label class="form-label">Descrição (opcional)</label>
                                <input type="text" class="form-control" @bind="secretForm.Description" 
                                       placeholder="Descrição do secret" />
                            </div>
                        }
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseSecretModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveSecret" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @(isEditMode ? "Atualizar" : "Criar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal para visualizar secret -->
@if (showViewModal && selectedSecretValue != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Visualizar Secret: @selectedSecretValue.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseViewModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Valor:</label>
                        <pre class="bg-light p-3 rounded"><code>@selectedSecretValue.SecretString</code></pre>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted">
                                <strong>Version ID:</strong> @selectedSecretValue.VersionId
                            </small>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">
                                <strong>Criado:</strong> @selectedSecretValue.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseViewModal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de confirmação de exclusão -->
@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja excluir o secret <strong>@secretToDelete</strong>?</p>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="forceDelete" id="forceDelete">
                        <label class="form-check-label" for="forceDelete">
                            Exclusão permanente (não pode ser recuperado)
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteSecret" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Excluir
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<SecretInfo> secrets = new();
    private bool isLoading = true;
    
    private bool showSecretModal = false;
    private bool showViewModal = false;
    private bool showDeleteModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool forceDelete = false;
    private SecretFormModel secretForm = new();
    private SecretValue? selectedSecretValue;
    private string secretToDelete = "";

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnNotification += HandleNotification;
        await LoadSecrets();
    }

    private async Task LoadSecrets()
    {
        isLoading = true;
        try
        {
            var result = await LocalStackService.GetSecretsAsync();
            if (result.IsSuccess && result.Data != null)
            {
                secrets = result.Data.ToList();
            }
            else
            {
                secrets.Clear();
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshSecrets()
    {
        await LoadSecrets();
    }

    private void ShowCreateSecretModal()
    {
        secretForm = new SecretFormModel();
        isEditMode = false;
        showSecretModal = true;
    }

    private void ShowUpdateSecretModal(string secretName)
    {
        secretForm = new SecretFormModel { Name = secretName };
        isEditMode = true;
        showSecretModal = true;
    }

    private void CloseSecretModal()
    {
        showSecretModal = false;
        secretForm = new SecretFormModel();
    }

    private async Task SaveSecret()
    {
        if (string.IsNullOrWhiteSpace(secretForm.Name) || string.IsNullOrWhiteSpace(secretForm.Value))
            return;

        isSaving = true;
        try
        {
            OperationResult<string> result;
            
            if (isEditMode)
            {
                var updateResult = await LocalStackService.UpdateSecretAsync(secretForm.Name, secretForm.Value);
                result = new OperationResult<string>(updateResult.IsSuccess, updateResult.IsSuccess ? "Updated" : null, updateResult.ErrorMessage, updateResult.Exception);
            }
            else
            {
                result = await LocalStackService.CreateSecretAsync(secretForm.Name, secretForm.Value, secretForm.Description);
            }

            if (result.IsSuccess)
            {
                CloseSecretModal();
                await LoadSecrets();
            }
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task ViewSecret(string secretName)
    {
        var result = await LocalStackService.GetSecretValueAsync(secretName);
        if (result.IsSuccess && result.Data != null)
        {
            selectedSecretValue = result.Data;
            showViewModal = true;
        }
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        selectedSecretValue = null;
    }

    private void ShowDeleteConfirmation(string secretName)
    {
        secretToDelete = secretName;
        forceDelete = false;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        secretToDelete = "";
        forceDelete = false;
    }

    private async Task DeleteSecret()
    {
        if (string.IsNullOrEmpty(secretToDelete))
            return;

        isDeleting = true;
        try
        {
            var result = await LocalStackService.DeleteSecretAsync(secretToDelete, forceDelete);
            if (result.IsSuccess)
            {
                CloseDeleteModal();
                await LoadSecrets();
            }
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private void HandleNotification(NotificationMessage notification)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        NotificationService.OnNotification -= HandleNotification;
    }

    private class SecretFormModel
    {
        public string Name { get; set; } = "";
        public string Value { get; set; } = "";
        public string Description { get; set; } = "";
    }
}
