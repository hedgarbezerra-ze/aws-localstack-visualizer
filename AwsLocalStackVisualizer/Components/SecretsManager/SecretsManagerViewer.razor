@page "/secrets"
@page "/secrets/{SecretName?}"
@using AwsLocalStackVisualizer.Abstractions
@using AwsLocalStackVisualizer.Models.Common
@using AwsLocalStackVisualizer.Models.SecretsManager
@using AwsLocalStackVisualizer.Services
@inject ILocalStackService LocalStackService
@inject IReadOnlyService ReadOnlyService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Secrets Manager - LocalStack Visualizer</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5">
                        Secrets Manager
                    </h1>
                    @if (!string.IsNullOrEmpty(SecretName))
                    {
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/secrets" class="text-decoration-none">Secrets</a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">@SecretName</li>
                            </ol>
                        </nav>
                    }
                </div>
                <div class="btn-group">
                    @if (string.IsNullOrEmpty(SecretName))
                    {
                        <button class="btn btn-success" @onclick="ShowCreateSecretModal" disabled="@ReadOnlyService.IsReadOnly">
                            <i class="bi bi-plus-circle"></i> Criar Secret
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="() => ShowUpdateSecretModal()" disabled="@ReadOnlyService.IsReadOnly">
                            <i class="bi bi-pencil"></i> Atualizar
                        </button>
                    }
                    <button class="btn btn-outline-primary" @onclick="RefreshData">
                        <i class="bi bi-arrow-clockwise"></i> Atualizar
                    </button>
                </div>
            </div>
                </div>
            </div>

            @if (isLoading)
            {
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                        </div>
                        <p class="mt-2 text-muted">Carregando secrets...</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (hasError)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Erro ao carregar secrets</h4>
                    <p>Ocorreu um erro ao tentar carregar os secrets do LocalStack.</p>
                    <hr>
                    <button class="btn btn-outline-danger" @onclick="RefreshData">
                        <i class="bi bi-arrow-clockwise"></i> Tentar novamente
                    </button>
                </div>
                    </div>
                </div>
            }
    else if (string.IsNullOrEmpty(SecretName))
    {
                @if (secrets.Any())
            {
                <div class="row">
                    @foreach (var secret in paginatedSecrets)
                    {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h5 class="card-title text-truncate" title="@secret.Name">
                                        <i class="bi bi-key text-info me-2"></i>@secret.Name
                                    </h5>
                                        <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                            <li><button class="dropdown-item" @onclick="() => NavigateToSecret(secret.Name)">
                                                <i class="bi bi-eye"></i> Visualizar
                                                </button></li>
                                                <li><button class="dropdown-item" @onclick="() => ShowUpdateSecretModal(secret.Name)">
                                                <i class="bi bi-pencil"></i> Editar
                                                </button></li>
                                                <li><hr class="dropdown-divider"></li>
                                            <li><button class="dropdown-item text-danger" @onclick="() => ShowDeleteSecretModal(secret.Name)" disabled="@ReadOnlyService.IsReadOnly">
                                                <i class="bi bi-trash"></i> Excluir
                                                </button></li>
                                            </ul>
                                        </div>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(secret.Description))
                                    {
                                    <p class="card-text text-muted small mb-3">@secret.Description</p>
                                    }
                                    
                                    <div class="small text-muted">
                                    <div class="mb-1">
                                        <i class="bi bi-calendar-plus me-1"></i>
                                        <strong>Criado:</strong> @secret.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                        @if (secret.LastChangedDate.HasValue)
                                    {
                                        <div class="mb-1">
                                            <i class="bi bi-calendar-check me-1"></i>
                                            <strong>Modificado:</strong> @secret.LastChangedDate.Value.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    }
                                </div>
                                
                                <div class="card-footer bg-transparent border-0 px-0 pb-0">
                                    <div class="d-grid gap-2">
                                        <button class="btn btn-info btn-sm" @onclick="() => NavigateToSecret(secret.Name)">
                                            <i class="bi bi-eye"></i> Visualizar Detalhes
                                        </button>
                                        <div class="btn-group">
                                            <button class="btn btn-outline-primary btn-sm" @onclick="() => ShowUpdateSecretModal(secret.Name)">
                                                <i class="bi bi-pencil"></i> Editar
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => ShowDeleteSecretModal(secret.Name)" disabled="@ReadOnlyService.IsReadOnly">
                                                <i class="bi bi-trash"></i> Excluir
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            
            @if (totalPages > 1)
            {
                <div class="row mt-4">
                    <div class="col-12">
                        <nav aria-label="Paginação de secrets">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)">
                                        <i class="bi bi-chevron-left"></i> Anterior
                                    </button>
                                </li>
                                
                                @for (int page = 1; page <= totalPages; page++)
                                {
                                    var pageNumber = page;
                                    <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == totalPages)">
                                        Próxima <i class="bi bi-chevron-right"></i>
                                    </button>
                                </li>
                            </ul>
                        </nav>
                        <div class="text-center text-muted">
                            <small>Página @currentPage de @totalPages (@secrets.Count secrets no total)</small>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-info" role="alert">
                        <h4 class="alert-heading">Nenhum secret encontrado</h4>
                        <p>Não há secrets criados no LocalStack.</p>
                        <hr>
                        <button class="btn btn-success" @onclick="ShowCreateSecretModal">
                            <i class="bi bi-plus-circle"></i> Criar Primeiro Secret
                        </button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        @if (secretDetails != null)
        {
            <div class="row">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-key text-info me-2"></i>@secretDetails.SecretInfo.Name
                                </h5>
                                <div class="btn-group">
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => ShowUpdateSecretModal()">
                                        <i class="bi bi-pencil"></i> Editar
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => ShowDeleteSecretModal(secretDetails.SecretInfo.Name)" disabled="@ReadOnlyService.IsReadOnly">
                                        <i class="bi bi-trash"></i> Excluir
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(secretDetails.SecretInfo.Description))
                            {
                                <div class="mb-3">
                                    <strong>Descrição:</strong>
                                    <p class="text-muted mb-0">@secretDetails.SecretInfo.Description</p>
                                </div>
                            }
                            
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Criado em:</strong>
                                    <p class="text-muted mb-0">@secretDetails.SecretInfo.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</p>
                                </div>
                                @if (secretDetails.SecretInfo.LastChangedDate.HasValue)
                                {
                                    <div class="col-md-6">
                                        <strong>Última modificação:</strong>
                                        <p class="text-muted mb-0">@secretDetails.SecretInfo.LastChangedDate.Value.ToString("dd/MM/yyyy HH:mm:ss")</p>
                                    </div>
                                }
                            </div>
                            
                            @if (secretDetails.Versions.Any())
                            {
                                <div class="mb-3">
                                    <strong>Versões:</strong>
                                    <div class="mt-2">
                                        @foreach (var version in secretDetails.Versions.Take(5))
                                        {
                                            <span class="badge bg-secondary me-1" title="Criada em @version.CreatedDate.ToString("dd/MM/yyyy HH:mm")">
                                                @version.VersionId
                                            </span>
                                        }
                                        @if (secretDetails.Versions.Count > 5)
                                        {
                                            <span class="text-muted">+@(secretDetails.Versions.Count - 5) mais</span>
                                                }
                                            </div>
                                </div>
                            }
                            
                            @if (secretValue != null)
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong>Valor do Secret:</strong>
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleSecretVisibility">
                                                <i class="bi @(showSecretValue ? "bi-eye-slash" : "bi-eye")"></i>
                                                @(showSecretValue ? "Ocultar" : "Mostrar")
                                            </button>
                                            @if (showSecretValue && IsValidJson(secretValue.SecretString ?? ""))
                                            {
                                                <button class="btn btn-outline-primary btn-sm" @onclick="ToggleJsonFormatting">
                                                    <i class="bi @(isFormattedJson ? "bi-code-slash" : "bi-code")"></i>
                                                    @(isFormattedJson ? "Compacto" : "Formatado")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <div class="border rounded bg-light" style="max-height: 400px; overflow: auto;">
                                        @if (showSecretValue)
                                        {
                                            @if (IsValidJson(secretValue.SecretString ?? ""))
                                            {
                                                <div class="json-viewer @(isFormattedJson ? "json-formatted" : "json-compact")">
                                                    @GetFormattedJson(secretValue.SecretString ?? "")
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="json-viewer json-text">
                                                    @(secretValue.SecretString ?? "")
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-muted text-center py-4">
                                                <i class="bi bi-eye-slash fs-1"></i>
                                                <p class="mb-0 mt-2">Clique em "Mostrar" para visualizar o conteúdo</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                </div>
            }
            else
            {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-warning" role="alert">
                        <h4 class="alert-heading">Secret não encontrado</h4>
                        <p>O secret solicitado não foi encontrado.</p>
                        <hr>
                        <a href="/secrets" class="btn btn-outline-warning">
                            <i class="bi bi-arrow-left"></i> Voltar à lista
                        </a>
                    </div>
                </div>
            </div>
        }
            }
</div>

@if (showSecretModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Editar Secret" : "Criar Secret")</h5>
                    <button type="button" class="btn-close" @onclick="CloseSecretModal"></button>
                </div>
                <div class="modal-body">
                    <form @onsubmit="SaveSecret" @onsubmit:preventDefault="true">
                        <div class="mb-3">
                            <label class="form-label">Nome do Secret</label>
                            <input type="text" class="form-control" @bind="secretForm.Name" 
                                   placeholder="meu-secret" disabled="@isEditMode" required />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Modo de Edição</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="editMode" id="jsonMode" @onchange="() => SetEditMode(true)" checked="@isJsonMode">
                                <label class="btn btn-outline-primary" for="jsonMode">
                                    <i class="bi bi-braces me-1"></i>JSON
                                </label>
                                
                                <input type="radio" class="btn-check" name="editMode" id="keyValueMode" @onchange="() => SetEditMode(false)" checked="@(!isJsonMode)" disabled="@(!canUseKeyValueMode)">
                                <label class="btn btn-outline-primary @(canUseKeyValueMode ? "" : "disabled")" for="keyValueMode">
                                    <i class="bi bi-list-ul me-1"></i>Chave-Valor
                                </label>
                            </div>
                            @if (!canUseKeyValueMode && !string.IsNullOrWhiteSpace(keyValueModeDisabledReason))
                            {
                                <div class="form-text text-warning">
                                    <i class="bi bi-exclamation-triangle me-1"></i>@keyValueModeDisabledReason
                                </div>
                            }
                        </div>

                        @if (isJsonMode)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label mb-0">Valor do Secret (JSON)</label>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="FormatJsonSecret" title="Formatar e organizar JSON">
                                        <i class="bi bi-braces me-1"></i>Formatar JSON
                                    </button>
                                </div>
                                <textarea class="form-control font-monospace" 
                                          rows="12" 
                                          @bind="secretForm.Value" 
                                          @oninput="OnSecretValueInput"
                                          placeholder='{"chave": "valor", "outra_chave": "outro_valor"}'
                                          style="resize: vertical; font-size: 14px; line-height: 1.4;"
                                          required></textarea>
                                <div class="form-text d-flex justify-content-between align-items-center">
                                    <span class="@(isValidSecretJson ? "text-success" : (secretJsonValidationMessage != null ? "text-danger" : "text-muted"))">
                                        @if (isValidSecretJson)
                                        {
                                            <i class="bi bi-check-circle-fill"></i><text> JSON válido</text>
                                        }
                                        else if (secretJsonValidationMessage != null)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill"></i> @secretJsonValidationMessage
                                        }
                                        else
                                        {
                                            <span>Caracteres: @secretForm.Value.Length</span>
                                        }
                                    </span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label mb-0">Propriedades do Secret</label>
                                    <button type="button" class="btn btn-sm btn-success" @onclick="AddKeyValuePair">
                                        <i class="bi bi-plus-circle me-1"></i>Adicionar
                                    </button>
                                </div>
                                
                                @if (keyValuePairs.Any())
                                {
                                    <div class="border rounded p-3">
                                        @for (int i = 0; i < keyValuePairs.Count; i++)
                                        {
                                            var index = i;
                                            var isDuplicateKey = IsDuplicateKey(index);
                                            <div class="row mb-3 align-items-start">
                                                <div class="col-4">
                                                    <input type="text" class="form-control form-control-sm @(isDuplicateKey ? "border-warning bg-warning-subtle" : "")" 
                                                           @bind="keyValuePairs[index].Key" 
                                                           @oninput="(e) => OnKeyValueKeyInput(index, e)"
                                                           placeholder="chave" 
                                                           title="@(isDuplicateKey ? "Propriedade duplicada - será sobrescrita no JSON final" : "")" />
                                                    @if (isDuplicateKey)
                                                    {
                                                        <div class="form-text text-warning small mt-1">
                                                            <i class="bi bi-exclamation-triangle me-1"></i>Propriedade duplicada
                                                        </div>
                                                    }
                                                </div>
                                                <div class="col-7">
                                                    <input type="text" class="form-control form-control-sm" 
                                                           @bind="keyValuePairs[index].Value" 
                                                           placeholder="valor" />
                                                </div>
                                                <div class="col-1 d-flex justify-content-center">
                                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                                            @onclick="() => RemoveKeyValuePair(index)"
                                                            title="Remover propriedade">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-3 border rounded bg-light">
                                        <p class="text-muted mb-2">Nenhuma propriedade adicionada</p>
                                        <button type="button" class="btn btn-sm btn-success" @onclick="AddKeyValuePair">
                                            <i class="bi bi-plus-circle me-1"></i>Adicionar Primeira Propriedade
                                        </button>
                                    </div>
                                }
                            </div>
                            
                            @if (!isJsonMode && HasDuplicateKeys())
                            {
                                <div class="alert alert-danger mt-3 mb-0" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <strong>Propriedades duplicadas detectadas:</strong> Remova as duplicatas para poder salvar o secret.
                                </div>
                            }
                        }
                        
                        @if (!isEditMode)
                        {
                            <div class="mb-3">
                                <label class="form-label">Descrição (opcional)</label>
                                <input type="text" class="form-control" @bind="secretForm.Description" 
                                       placeholder="Descrição do secret" />
                            </div>
                        }
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseSecretModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="SaveSecret" disabled="@(isSaving || string.IsNullOrWhiteSpace(secretForm.Name) || (!isJsonMode && (!keyValuePairs.Any() || HasDuplicateKeys())) || (isJsonMode && string.IsNullOrWhiteSpace(secretForm.Value)))">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi @(isEditMode ? "bi-pencil" : "bi-plus-circle") me-1"></i>
                        }
                        @(isEditMode ? "Atualizar" : "Criar Secret")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja excluir o secret <strong>@secretToDelete</strong>?</p>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="forceDelete" id="forceDelete">
                        <label class="form-check-label" for="forceDelete">
                            Exclusão permanente (não pode ser recuperado)
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteSecret" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-trash me-1"></i>
                        }
                        Excluir Secret
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? SecretName { get; set; }

    private List<SecretInfo> secrets = new();
    private SecretDetails? secretDetails;
    private SecretValue? secretValue;
    private bool isLoading = true;
    private bool hasError = false;
    private bool showSecretValue = false;
    private bool isFormattedJson = true;
    
    private int currentPage = 1;
    private const int itemsPerPage = 6;
    private int totalPages => (int)Math.Ceiling((double)secrets.Count / itemsPerPage);
    private List<SecretInfo> paginatedSecrets => secrets.Skip((currentPage - 1) * itemsPerPage).Take(itemsPerPage).ToList();
    
    private bool showSecretModal = false;
    private bool showDeleteModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool forceDelete = false;
    private SecretFormModel secretForm = new();
    private string secretToDelete = "";
    
    private bool isJsonMode = true;
    private bool isValidSecretJson = false;
    private string? secretJsonValidationMessage = null;
    private List<KeyValuePairModel> keyValuePairs = new();
    private bool canUseKeyValueMode = true;
    private string? keyValueModeDisabledReason = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(SecretName))
            {
                var result = await LocalStackService.GetSecretsAsync();
                secrets = result.IsSuccess && result.Data != null ? result.Data.ToList() : new List<SecretInfo>();
                secretDetails = null;
                secretValue = null;
            }
            else
            {
                var detailsResult = await LocalStackService.GetSecretDetailsAsync(SecretName);
                secretDetails = detailsResult.IsSuccess ? detailsResult.Data : null;
                secrets.Clear();
                
                if (secretDetails != null)
                {
                    var valueResult = await LocalStackService.GetSecretValueAsync(SecretName);
                    secretValue = valueResult.IsSuccess ? valueResult.Data : null;
                }
            }
        }
        catch (Exception)
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private async Task NavigateToSecret(string secretName)
    {
        await JSRuntime.InvokeVoidAsync("eval", $"window.location.href = '/secrets/{secretName}'");
    }

    private void ToggleSecretVisibility()
    {
        showSecretValue = !showSecretValue;
    }

    private void ShowCreateSecretModal()
    {
        secretForm = new SecretFormModel();
        keyValuePairs.Clear();
        keyValuePairs.Add(new KeyValuePairModel());
        isEditMode = false;
        isJsonMode = true;
        isValidSecretJson = false;
        secretJsonValidationMessage = null;
        canUseKeyValueMode = true;
        keyValueModeDisabledReason = null;
        showSecretModal = true;
    }

    private async Task ShowUpdateSecretModal(string secretName = "")
    {
        var name = !string.IsNullOrEmpty(secretName) ? secretName : SecretName ?? "";
        secretForm = new SecretFormModel { Name = name };
        isEditMode = true;
        isJsonMode = true;
        isValidSecretJson = false;
        secretJsonValidationMessage = null;
        keyValuePairs.Clear();
        
        if (!string.IsNullOrEmpty(name))
        {
            var valueResult = await LocalStackService.GetSecretValueAsync(name);
            if (valueResult.IsSuccess && valueResult.Data != null)
            {
                secretForm.Value = valueResult.Data.SecretString ?? "";
                
                try
                {
                    var jsonDoc = System.Text.Json.JsonDocument.Parse(secretForm.Value);
                    CheckKeyValueModeAvailability(jsonDoc);
                    
                    if (jsonDoc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object && canUseKeyValueMode)
                    {
                        foreach (var property in jsonDoc.RootElement.EnumerateObject())
                        {
                            keyValuePairs.Add(new KeyValuePairModel 
                            { 
                                Key = property.Name, 
                                Value = property.Value.GetString() ?? property.Value.ToString()
                            });
                        }
                        isJsonMode = false; // Iniciar no modo chave-valor se for um objeto simples
                    }
                    else
                    {
                        isJsonMode = true; // Manter no modo JSON se for complexo
                    }
                    isValidSecretJson = true;
                }
                catch
                {
                    isJsonMode = true;
                    canUseKeyValueMode = true;
                    keyValueModeDisabledReason = null;
                }
                
                if (!keyValuePairs.Any())
                {
                    keyValuePairs.Add(new KeyValuePairModel());
                }
            }
        }
        
        showSecretModal = true;
    }

    private void CloseSecretModal()
    {
        showSecretModal = false;
        secretForm = new SecretFormModel();
        keyValuePairs.Clear();
        isValidSecretJson = false;
        secretJsonValidationMessage = null;
        canUseKeyValueMode = true;
        keyValueModeDisabledReason = null;
    }

    private void CheckKeyValueModeAvailability(System.Text.Json.JsonDocument jsonDoc)
    {
        canUseKeyValueMode = true;
        keyValueModeDisabledReason = null;
        
        if (jsonDoc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
        {
            canUseKeyValueMode = false;
            keyValueModeDisabledReason = "Modo chave-valor disponível apenas para objetos JSON simples";
            return;
        }
        
        foreach (var property in jsonDoc.RootElement.EnumerateObject())
        {
            var valueKind = property.Value.ValueKind;
            if (valueKind == System.Text.Json.JsonValueKind.Object)
            {
                canUseKeyValueMode = false;
                keyValueModeDisabledReason = "JSON contém objetos aninhados - use o modo JSON";
                return;
            }
            if (valueKind == System.Text.Json.JsonValueKind.Array)
            {
                canUseKeyValueMode = false;
                keyValueModeDisabledReason = "JSON contém arrays - use o modo JSON";
                return;
            }
        }
    }

    private void SetEditMode(bool jsonMode)
    {
        if (!jsonMode && !canUseKeyValueMode)
        {
            isJsonMode = true;
            return;
        }
        
        isJsonMode = jsonMode;
        
        if (!isJsonMode)
        {
            if (!string.IsNullOrWhiteSpace(secretForm.Value))
            {
                try
                {
                    var jsonDoc = System.Text.Json.JsonDocument.Parse(secretForm.Value);
                    CheckKeyValueModeAvailability(jsonDoc);
                    
                    if (jsonDoc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object && canUseKeyValueMode)
                    {
                        keyValuePairs.Clear();
                        foreach (var property in jsonDoc.RootElement.EnumerateObject())
                        {
                            keyValuePairs.Add(new KeyValuePairModel 
                            { 
                                Key = property.Name, 
                                Value = property.Value.GetString() ?? property.Value.ToString()
                            });
                        }
                    }
                    else if (!canUseKeyValueMode)
                    {
                        isJsonMode = true;
                        return;
                    }
                }
                catch
                {
                    if (!keyValuePairs.Any())
                    {
                        keyValuePairs.Add(new KeyValuePairModel());
                    }
                }
            }
            else if (!keyValuePairs.Any())
            {
                keyValuePairs.Add(new KeyValuePairModel());
            }
        }
        else
        {
            if (keyValuePairs.Any(kv => !string.IsNullOrWhiteSpace(kv.Key)))
            {
                var jsonObject = new Dictionary<string, string>();
                foreach (var pair in keyValuePairs.Where(kv => !string.IsNullOrWhiteSpace(kv.Key)))
                {
                    jsonObject[pair.Key] = pair.Value ?? "";
                }
                
                secretForm.Value = System.Text.Json.JsonSerializer.Serialize(jsonObject, new System.Text.Json.JsonSerializerOptions 
                { 
                    WriteIndented = true,
                    Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
                });
                ValidateSecretJsonSilently();
            }
        }
        
        StateHasChanged();
    }

    private void AddKeyValuePair()
    {
        keyValuePairs.Add(new KeyValuePairModel());
        StateHasChanged();
    }

    private void RemoveKeyValuePair(int index)
    {
        if (index >= 0 && index < keyValuePairs.Count)
        {
            keyValuePairs.RemoveAt(index);
            StateHasChanged();
        }
    }

    private void OnKeyValueKeyInput(int index, ChangeEventArgs e)
    {
        if (index >= 0 && index < keyValuePairs.Count)
        {
            keyValuePairs[index].Key = e.Value?.ToString() ?? string.Empty;
            StateHasChanged();
        }
    }

    private bool IsDuplicateKey(int currentIndex)
    {
        if (currentIndex < 0 || currentIndex >= keyValuePairs.Count)
            return false;

        var currentKey = keyValuePairs[currentIndex].Key;
        
        if (string.IsNullOrWhiteSpace(currentKey))
            return false;

        for (int i = 0; i < keyValuePairs.Count; i++)
        {
            if (i != currentIndex && 
                !string.IsNullOrWhiteSpace(keyValuePairs[i].Key) && 
                keyValuePairs[i].Key == currentKey)
            {
                return true;
            }
        }

        return false;
    }

    private bool HasDuplicateKeys()
    {
        var nonEmptyKeys = keyValuePairs
            .Where(kv => !string.IsNullOrWhiteSpace(kv.Key))
            .Select(kv => kv.Key)
            .ToList();

        return nonEmptyKeys.Count != nonEmptyKeys.Distinct().Count();
    }

    private void OnSecretValueInput(ChangeEventArgs e)
    {
        secretForm.Value = e.Value?.ToString() ?? string.Empty;
        ValidateSecretJsonSilently();
    }

    private void ValidateSecretJsonSilently()
    {
        if (string.IsNullOrWhiteSpace(secretForm.Value))
        {
            isValidSecretJson = false;
            secretJsonValidationMessage = null;
            canUseKeyValueMode = true;
            keyValueModeDisabledReason = null;
            return;
        }

        var trimmed = secretForm.Value.Trim();
        if (!trimmed.StartsWith("{") && !trimmed.StartsWith("["))
        {
            isValidSecretJson = false;
            secretJsonValidationMessage = null;
            canUseKeyValueMode = true;
            keyValueModeDisabledReason = null;
            return;
        }

        try
        {
            var jsonDoc = System.Text.Json.JsonDocument.Parse(secretForm.Value);
            CheckKeyValueModeAvailability(jsonDoc);
            isValidSecretJson = true;
            secretJsonValidationMessage = null;
        }
        catch (System.Text.Json.JsonException ex)
        {
            isValidSecretJson = false;
            secretJsonValidationMessage = $"JSON inválido: {ex.Message}";
            canUseKeyValueMode = true;
            keyValueModeDisabledReason = null;
        }
    }

    private void FormatJsonSecret()
    {
        if (string.IsNullOrWhiteSpace(secretForm.Value))
            return;

        try
        {
            var jsonDoc = System.Text.Json.JsonDocument.Parse(secretForm.Value);
            secretForm.Value = System.Text.Json.JsonSerializer.Serialize(jsonDoc, new System.Text.Json.JsonSerializerOptions 
            { 
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
            ValidateSecretJsonSilently();
            StateHasChanged();
        }
        catch (System.Text.Json.JsonException ex)
        {
            secretJsonValidationMessage = $"Erro ao formatar: {ex.Message}";
            isValidSecretJson = false;
            StateHasChanged();
        }
    }

    private async Task SaveSecret()
    {
        if (string.IsNullOrWhiteSpace(secretForm.Name))
            return;
            
        string finalValue = "";
        
        if (isJsonMode)
        {
            if (string.IsNullOrWhiteSpace(secretForm.Value))
                return;
            finalValue = secretForm.Value;
        }
        else
        {
            var validPairs = keyValuePairs.Where(kv => !string.IsNullOrWhiteSpace(kv.Key)).ToList();
            if (!validPairs.Any())
                return;
                
            var jsonObject = new Dictionary<string, string>();
            foreach (var pair in validPairs)
            {
                jsonObject[pair.Key] = pair.Value ?? "";
            }
            
            finalValue = System.Text.Json.JsonSerializer.Serialize(jsonObject, new System.Text.Json.JsonSerializerOptions 
            { 
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
        }

        isSaving = true;
        try
        {
            OperationResult<string> result;
            
            if (isEditMode)
            {
                var updateResult = await LocalStackService.UpdateSecretAsync(secretForm.Name, finalValue);
                result = new OperationResult<string>(updateResult.IsSuccess, updateResult.IsSuccess ? "Updated" : null, updateResult.ErrorMessage, updateResult.Exception);
            }
            else
            {
                result = await LocalStackService.CreateSecretAsync(secretForm.Name, finalValue, secretForm.Description);
            }

            if (result.IsSuccess)
            {
                CloseSecretModal();
                await LoadData();
            }
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void ShowDeleteSecretModal(string secretName)
    {
        secretToDelete = secretName;
        forceDelete = false;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        secretToDelete = "";
        forceDelete = false;
    }

    private async Task DeleteSecret()
    {
        if (string.IsNullOrEmpty(secretToDelete))
            return;

        isDeleting = true;
        try
        {
            var result = await LocalStackService.DeleteSecretAsync(secretToDelete, forceDelete);
            if (result.IsSuccess)
            {
                CloseDeleteModal();
                await LoadData();
            }
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }


    private class SecretFormModel
    {
        public string Name { get; set; } = "";
        public string Value { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private class KeyValuePairModel
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void ToggleJsonFormatting()
    {
        isFormattedJson = !isFormattedJson;
        StateHasChanged();
    }

    private bool IsValidJson(string jsonString)
    {
        if (string.IsNullOrWhiteSpace(jsonString))
            return false;

        try
        {
            System.Text.Json.JsonDocument.Parse(jsonString);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private string GetFormattedJson(string jsonString)
    {
        if (string.IsNullOrWhiteSpace(jsonString))
            return jsonString;

        try
        {
            if (isFormattedJson)
            {
                using var document = System.Text.Json.JsonDocument.Parse(jsonString);
                return System.Text.Json.JsonSerializer.Serialize(document, new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = true,
                    Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
                });
            }
            else
            {
                using var document = System.Text.Json.JsonDocument.Parse(jsonString);
                return System.Text.Json.JsonSerializer.Serialize(document, new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = false,
                    Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
                });
            }
        }
        catch
        {
            return jsonString;
        }
    }
}

