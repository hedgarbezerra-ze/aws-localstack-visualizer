@using AwsLocalStackVisualizer.Abstractions
@inject INotificationService NotificationService
@implements IDisposable

<style>
    .toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 1055;
        max-width: 400px;
    }
    
    .toast-custom {
        min-width: 320px;
        max-width: 400px;
        margin-bottom: 10px;
        border: none;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
        backdrop-filter: blur(10px);
        animation: slideInRight 0.3s ease-out;
        transition: all 0.3s ease;
    }
    
    .toast-custom.removing {
        animation: slideOutRight 0.3s ease-in;
        transform: translateX(100%);
        opacity: 0;
    }
    
    .toast-custom .toast-header {
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px 12px 0 0;
        padding: 12px 16px;
        font-weight: 600;
    }
    
    .toast-custom .toast-body {
        padding: 12px 16px;
        border-radius: 0 0 12px 12px;
        font-size: 14px;
        line-height: 1.4;
    }
    
    .toast-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
    }
    
    .toast-error {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }
    
    .toast-warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
    }
    
    .toast-info {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
    }
    
    .btn-close-custom {
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.8);
        font-size: 18px;
        cursor: pointer;
        padding: 0;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.2s ease;
    }
    
    .btn-close-custom:hover {
        color: white;
        background: rgba(255, 255, 255, 0.2);
        transform: scale(1.1);
    }
    
    .toast-icon {
        font-size: 18px;
        margin-right: 8px;
    }
    
    
    @@keyframes slideInRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
    
    @@keyframes slideOutRight {
        from {
            transform: translateX(0);
            opacity: 1;
        }
        to {
            transform: translateX(100%);
            opacity: 0;
        }
    }
    
    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }
    
    .toast-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
    }
</style>

@if (notifications.Any())
{
    <div class="toast-container">
        @foreach (var notification in notifications.ToList())
        {
            <div class="toast-custom @GetToastClass(notification.Type) @(notification.IsRemoving ? "removing" : "")" 
                 role="alert" 
                 id="toast-@notification.Id">
                <div class="toast-header">
                    <i class="@GetIconClass(notification.Type) toast-icon"></i>
                    <strong class="me-auto">@notification.Title</strong>
                    <button type="button" class="btn-close-custom" 
                            @onclick="@(() => RemoveNotificationWithAnimation(notification.Id))" 
                            aria-label="Fechar">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="toast-body">
                    @notification.Message
                </div>
            </div>
        }
    </div>
}

@code {
    private List<NotificationItem> notifications = new();
    private Timer? autoRemoveTimer;

    protected override void OnInitialized()
    {
        NotificationService.OnNotification += HandleNotification;
        
        autoRemoveTimer = new Timer(RemoveExpiredNotifications, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void HandleNotification(NotificationMessage notification)
    {
        var item = new NotificationItem
        {
            Id = Guid.NewGuid(),
            Type = notification.Type,
            Title = notification.Title,
            Message = notification.Message,
            CreatedAt = DateTime.Now
        };

        notifications.Add(item);
        
        if (notifications.Count > 5)
        {
            notifications.RemoveAt(0);
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task RemoveNotificationWithAnimation(Guid id)
    {
        var notification = notifications.FirstOrDefault(n => n.Id == id);
        if (notification != null)
        {
            notification.IsRemoving = true;
            await InvokeAsync(StateHasChanged);
            
            await Task.Delay(300);
            
            notifications.Remove(notification);
            await InvokeAsync(StateHasChanged);
        }
    }


    private async void RemoveExpiredNotifications(object? state)
    {
        var expiredNotifications = notifications
            .Where(n => DateTime.Now - n.CreatedAt > TimeSpan.FromSeconds(GetAutoRemoveSeconds(n.Type)) && !n.IsRemoving)
            .ToList();

        if (expiredNotifications.Any())
        {
            foreach (var expired in expiredNotifications)
            {
                expired.IsRemoving = true;
            }
            
            await InvokeAsync(StateHasChanged);
            
            await Task.Delay(300);
            
            foreach (var expired in expiredNotifications)
            {
                notifications.Remove(expired);
            }
            
            await InvokeAsync(StateHasChanged);
        }
    }

    private static int GetAutoRemoveSeconds(NotificationType type) => type switch
    {
        NotificationType.Success => 3,
        NotificationType.Info => 4,
        NotificationType.Warning => 5,
        NotificationType.Error => 6,
        _ => 4
    };

    private static string GetToastClass(NotificationType type) => type switch
    {
        NotificationType.Success => "toast-success",
        NotificationType.Info => "toast-info",
        NotificationType.Warning => "toast-warning",
        NotificationType.Error => "toast-error",
        _ => "toast-info"
    };

    private static string GetIconClass(NotificationType type) => type switch
    {
        NotificationType.Success => "fas fa-check-circle",
        NotificationType.Info => "fas fa-info-circle",
        NotificationType.Warning => "fas fa-exclamation-triangle",
        NotificationType.Error => "fas fa-exclamation-circle",
        _ => "fas fa-bell"
    };

    public void Dispose()
    {
        NotificationService.OnNotification -= HandleNotification;
        autoRemoveTimer?.Dispose();
    }

    private class NotificationItem
    {
        public Guid Id { get; set; }
        public NotificationType Type { get; set; }
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public bool IsRemoving { get; set; } = false;
    }
}
